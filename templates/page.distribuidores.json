{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"show_title":true,"show_content":true}},"custom_liquid_UYwAEE":{"type":"custom-liquid","name":"Custom Liquid","settings":{"use_container":false,"custom_liquid":"<style>\na:hover svg {\n    margin-left: 5px;\ntransition: margin-left 0.3s ease-in-out;\n}\n        \/* Reset y estilos base *\/\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n            font-family: 'Arial', sans-serif;\n        }\n\n        body {\n            overflow-x: hidden;\n        }\n\n        \/* Contenedor principal *\/\n        .landing-container {\n            display: flex;\n            min-height: 100vh;\nbackground: #FF0203;\n        }\n\n        \/* Columna izquierda (banner) *\/\n        .banner-column {\n             flex: 0 0 60%; \/* No grow, no shrink, 60% width *\/\n            background-image: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0492\/2458\/1274\/files\/baner-proveedores.webp?v=1753901906?text=Banner');\n            background-size: cover;\n            background-position: center;\n            background-repeat: no-repeat;\n            position: relative;\n        }\n\n        \/* Columna derecha (contenido) *\/\n        .content-column {\nflex: 0 0 40%; \/* No grow, no shrink, 40% width *\/\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            padding: 2rem;\ncolor: #fff;\n        }\n\n        \/* Contenido principal *\/\n        .main-content {\n            margin-bottom: auto;\n            padding-top: 2rem;\n        }\n\n        h1 {\n            font-size: 2.5rem;\n            margin-bottom: 1.5rem;\n            color: #333;\n        }\n\n        p {\n            font-size: 1.5rem;\n            margin-bottom: 2rem;\n            color: #fff;\n            line-height: 1.6;\n        }\n\n        \/* Botones *\/\n        .buttons {\n            display: flex;\n            gap: 1rem;\n            margin-bottom: 2rem;\nborder-radius:4px;\n        }\n\n        .btn {\n            padding: 0.8rem 1.5rem;\n            border-radius: 4px;\n            text-decoration: none;\n            font-weight: bold;\n            transition: all 0.3s ease;\n        }\n\n        .btn-primary {\n            background-color: #4a6fa5;\n            color: white;\n        }\n\n        .btn-primary:hover {\n            background-color: #3a5a8f;\n        }\n\n        .btn-secondary {\n            background-color: transparent;\n            color: #4a6fa5;\n        }\n\n        .btn-secondary:hover {\n            background-color: #4a6fa5;\n            color: white;\n        }\n\n        \/* Logo en la parte inferior *\/\n        .logo-container {\n            margin-top: auto;\n            padding-bottom: 2rem;\n            text-align: center;\n        }\n\n        .logo {\n            max-width: 150px;\n            height: auto;\n        }\n\n        \/* Estilos responsive *\/\n        @media (max-width: 768px) {\n            .landing-container {\n                flex-direction: column;\n            }\n.banner-column {\n                order: 2; \/* Ahora aparece segundo *\/\n                min-height: 40vh;\n            }\n\n            .content-column {\n                order: 1; \/* Ahora aparece primero *\/\n            }\n\n            .banner-column {\n                min-height: 50vh;\n            }\n\n            .content-column {\n                padding: 1.5rem;\n            }\n\n            h1 {\n                font-size: 2rem;\n            }\n\n            .buttons {\n                flex-direction: column;\n                gap: 0.5rem;\n            }\n\n            .btn {\n                width: 100%;\n                text-align: center;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 1.8rem;\n            }\n\n            p {\n                font-size: 1rem;\n            }\n\n            .logo {\n                max-width: 120px;\n            }\n        }\n    <\/style>\n<\/head>\n<body>\n    <div class=\"landing-container\">\n        <!-- Columna izquierda - Banner -->\n        <div class=\"banner-column\">\n            <!-- Imagen de fondo aplicada via CSS -->\n        <\/div>\n\n        <!-- Columna derecha - Contenido -->\n        <div class=\"content-column\">\n            <div class=\"main-content\">\n                <p>Estamos transformando nuestro portal de proveedores para que tu experiencia se más ágil, clara y cercana.<\/p>\n                \n                <div class=\"buttons\">\n                    <a href=\"https:\/\/portalproveedores.supervaquita.com.co\"  target=\"_blank\" class=\"btn btn-secondary\">Portal Anterior<\/a>\n                    <a href=\"https:\/\/supplier.supermu.com\/welcome\" target=\"_blank\" class=\"btn btn-secondary\">Portal Nuevo<\/a>\n                <\/div>\n<a style=\"text-decoration: underline;\n    color: #fff;\n    display: flex\n;\n    align-items: center;\n    align-content: center;\n    gap: 5px;font-size:1rem\" href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0492\/2458\/1274\/files\/Guia-portal-proveedores-v2.pdf?v=1754424637\" target=\"_blank\">Descargar guía\/instructivo <svg  style=\"width: 25px;transition: margin-left 0.3s ease-in-out;\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"size-6\">\n  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M7.5 7.5h-.75A2.25 2.25 0 0 0 4.5 9.75v7.5a2.25 2.25 0 0 0 2.25 2.25h7.5a2.25 2.25 0 0 0 2.25-2.25v-7.5a2.25 2.25 0 0 0-2.25-2.25h-.75m-6 3.75 3 3m0 0 3-3m-3 3V1.5m6 9h.75a2.25 2.25 0 0 1 2.25 2.25v7.5a2.25 2.25 0 0 1-2.25 2.25h-7.5a2.25 2.25 0 0 1-2.25-2.25v-.75\" \/>\n<\/svg>\n<\/a>\n            <\/div>\n\n            <div class=\"logo-container\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0492\/2458\/1274\/files\/logo_png_supermu.png?v=175390560