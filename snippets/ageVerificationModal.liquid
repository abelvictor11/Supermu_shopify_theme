<div id="ageVerificationModal" class="age-verification-modal" style="display:none;">
  <div class="modal-content">
    <img src="//supermu.com/cdn/shop/files/logo_supermu_688x.svg?v=1747076574" alt="Supermu" class="brand-logo">
    <h2>Verificación de Edad</h2>
    <p>Para acceder a esta sección, debes ser mayor de 18 años Según la Ley 124 de 1994, está prohibida la venta de bebidas alcohólicas a menores de 18 años.</p>

    <div class="birthdate-selector">
      <select id="day" class="birthdate-select">
        <option value="">Día</option>
        {% for day in (1..31) %}
          <option value="{{ day }}">{{ day }}</option>
        {% endfor %}
      </select>

      <select id="month" class="birthdate-select">
        <option value="">Mes</option>
        <option value="1">Enero</option>
        <option value="2">Febrero</option>
        <option value="3">Marzo</option>
        <option value="4">Abril</option>
        <option value="5">Mayo</option>
        <option value="6">Junio</option>
        <option value="7">Julio</option>
        <option value="8">Agosto</option>
        <option value="9">Septiembre</option>
        <option value="10">Octubre</option>
        <option value="11">Noviembre</option>
        <option value="12">Diciembre</option>
      </select>

      <select id="year" class="birthdate-select">
        <option value="">Año</option>
        {% assign current_year = "now" | date: "%Y" | plus: 0 %}
        {% assign start_year = current_year | minus: 100 %}
        {% for year in (start_year..current_year) reversed %}
          <option value="{{ year }}">{{ year }}</option>
        {% endfor %}
      </select>
    </div>

    <div id="ageError" class="error-message" style="display:none;"></div>
    <div id="ageLegalNotice" class="legal-message" style="display:none;"></div>

    <div class="modal-buttons">
      <button id="confirmAge" class="btn btn-primary-1">Soy mayor de 18</button>
      <button id="denyAge" class="btn btn-secondary">Soy menor de edad</button>
    </div>
  </div>
</div>

<style>
  :root {
    --brand-red: #dd0a0a;
    --brand-black: #000;
    --brand-gray: #F8F8F8;
    --brand-dark-gray: #666;
    --brand-white: #fff;
    --base-family: "Work Sans", sans-serif;
  }

  .age-verification-modal {
    position: fixed;
    inset: 0;
    background-color: rgba(0,0,0,0.85);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 1;
    transition: opacity 0.6s ease;
    font-family: var(--base-family);
  }
  .age-verification-modal.fade-out {
    opacity: 0;
  }
  .modal-content {
    background: var(--brand-white);
    padding: 30px;
    border-radius: 10px;
    max-width: 500px;
    width: 90%;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }
  .brand-logo {
    max-width: 180px;
    margin-bottom: 20px;
  }
  h2 {
    color: var(--brand-red);
    margin-bottom: 10px;
  }
  p {
    color: var(--brand-black);
    font-size: 1rem;
    margin-bottom: 20px;
  }
  .birthdate-selector {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 15px;
  }
  .birthdate-select {
    padding: 8px;
    border-radius: 4px;
    border: 1px solid #ccc;
    font-family: var(--base-family);
  }
  .error-message {
    color: var(--brand-red);
    margin-bottom: 10px;
    font-weight: bold;
  }
  .legal-message {
    color: #b71c1c;
    margin-bottom: 15px;
    font-weight: bold;
    background: #ffdddd;
    padding: 15px;
    border-radius:8px;
  }
  .modal-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
  }
  .btn {
    padding: 10px 20px;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    font-weight: bold;
    font-family: var(--base-family);
    transition: background 0.3s ease;
  }
  .btn-primary-1 {
    background-color: #ff0000 !important;
    color: #fff !important;
  }
  .btn-primary-1:hover {
    background-color: #b20808 !important;
  }
  .btn-secondary {
    background-color: var(--brand-gray) !important;
    color: var(--brand-dark-gray) !important;
  }
  .btn-secondary:hover {
    background-color: #444 !important;
    color: var(--brand-white) !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const restrictedCollections = [
    '/collections/licores',
    '/collections/vinos-importados',
    '/collections/licores-importados',
    '/collections/tequila',
    '/collections/whiskey'
  ];

  const currentPath = window.location.pathname.replace(/\/$/, '');
  const isRestricted = restrictedCollections.includes(currentPath);
  
  if (isRestricted) {
    const ageVerified = getCookie('ageVerified');
    if (!ageVerified || ageVerified === 'false') {
      setTimeout(showModal, 300);
    }
  }

  function showModal() {
    document.getElementById('ageVerificationModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function hideModal() {
    const modal = document.getElementById('ageVerificationModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  function fadeOutAndRedirect(url) {
    const modal = document.getElementById('ageVerificationModal');
    modal.classList.add('fade-out');
    setTimeout(() => { window.location.href = url; }, 600);
  }

  document.getElementById('confirmAge').addEventListener('click', function () {
    const day = parseInt(document.getElementById('day').value, 10);
    const month = parseInt(document.getElementById('month').value, 10);
    const year = parseInt(document.getElementById('year').value, 10);
    const errorEl = document.getElementById('ageError');
    const legalEl = document.getElementById('ageLegalNotice');

    errorEl.style.display = 'none';
    legalEl.style.display = 'none';

    if (!day || !month || !year) {
      errorEl.textContent = 'Por favor completa tu fecha de nacimiento.';
      errorEl.style.display = 'block';
      return;
    }

    const birthDate = new Date(year, month - 1, day);
    if (birthDate.getDate() !== day || birthDate.getMonth() + 1 !== month || birthDate.getFullYear() !== year) {
      errorEl.textContent = 'La fecha ingresada no es válida.';
      errorEl.style.display = 'block';
      return;
    }

    const today = new Date();
    let age = today.getFullYear() - year;
    if (today.getMonth() < month - 1 || (today.getMonth() === month - 1 && today.getDate() < day)) {
      age--;
    }

    if (age >= 18) {
      setCookie('ageVerified', 'true', 30);
      hideModal();
    } else {
      setCookie('ageVerified', 'false', 1);
      legalEl.textContent = 'Para poder comprar licores, debes ser mayor de edad. Según la Ley 124 de 1994, está prohibida la venta de bebidas alcohólicas a menores de 18 años.';
      legalEl.style.display = 'block';
      setTimeout(() => fadeOutAndRedirect('/'), 3000);
    }
  });

  document.getElementById('denyAge').addEventListener('click', function () {
    setCookie('ageVerified', 'false', 1);
    const legalEl = document.getElementById('ageLegalNotice');
    legalEl.textContent = 'Para poder comprar licores, debes ser mayor de edad. Según la Ley 124 de 1994, está prohibida la venta de bebidas alcohólicas a menores de 18 años.';
    legalEl.style.display = 'block';
    setTimeout(() => fadeOutAndRedirect('/'), 3000);
  });

  function setCookie(name, value, days) {
    const date = new Date();
    date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
    document.cookie = `${name}=${value}; expires=${date.toUTCString()}; path=/; SameSite=Lax`;
  }

  function getCookie(name) {
    const cname = name + '=';
    return document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith(cname))?.substring(cname.length) || '';
  }
});
</script>
