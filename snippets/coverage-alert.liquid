{%- comment -%}
  Alerta de cobertura de entrega - Se muestra antes del botón de checkout
  Uso: {% render 'coverage-alert' %}
{%- endcomment -%}

<div class="coverage-alert">
  <div class="coverage-alert__icon">🔔</div>
  <div class="coverage-alert__content">
    <p class="coverage-alert__title">¡Recordatorio Importante!</p>
    <p class="coverage-alert__text">
      Antes de pagar, verifica que tu dirección esté dentro de nuestra 
      <a href="/pages/condiciones-de-entrega" class="coverage-alert__link">zona de cobertura</a>.
    </p>
    <p class="coverage-alert__note">
      Al hacer clic en "Pagar", confirmas que has verificado la cobertura.
    </p>
  </div>
</div>

<style>
.coverage-alert {
  display: flex;
  gap: 12px;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border: 1px solid #f59e0b;
  border-left: 4px solid #f59e0b;
  border-radius: 8px;
  padding: 14px 16px;
  margin: 16px 0;
  font-family: inherit;
}

.coverage-alert__icon {
  font-size: 1.4em;
  line-height: 1;
  flex-shrink: 0;
}

.coverage-alert__content {
  flex: 1;
  min-width: 0;
}

.coverage-alert__title {
  margin: 0 0 6px 0;
  font-weight: 700;
  font-size: 0.95em;
  color: #92400e;
}

.coverage-alert__text {
  margin: 0 0 8px 0;
  font-size: 0.88em;
  line-height: 1.45;
  color: #451a03;
}

.coverage-alert__link {
  color: #d97706;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.coverage-alert__link:hover {
  color: #b45309;
}

.coverage-alert__note {
  margin: 0;
  font-size: 0.8em;
  color: #78350f;
  font-style: italic;
  opacity: 0.85;
}

/* Versión compacta para popup cart */
.popup-cart .coverage-alert {
  padding: 10px 12px;
  margin: 12px 0;
  gap: 10px;
}

.popup-cart .coverage-alert__icon {
  font-size: 1.2em;
}

.popup-cart .coverage-alert__title {
  font-size: 0.9em;
  margin-bottom: 4px;
}

.popup-cart .coverage-alert__text {
  font-size: 0.82em;
  margin-bottom: 6px;
}

.popup-cart .coverage-alert__note {
  font-size: 0.75em;
}

/* Estados dinámicos según la verificación por geolocalización */
.coverage-alert.is-covered {
  background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
  border-color: #10b981;
  border-left-color: #10b981;
}
.coverage-alert.is-covered .coverage-alert__title { color: #065f46; }
.coverage-alert.is-covered .coverage-alert__text { color: #064e3b; }
.coverage-alert.is-out {
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
  border-color: #ef4444;
  border-left-color: #ef4444;
}
.coverage-alert.is-out .coverage-alert__title { color: #991b1b; }
.coverage-alert.is-out .coverage-alert__text { color: #7f1d1d; }
</style>

<script>
(function () {
  function applyCoverage() {
    var raw;
    try { raw = localStorage.getItem('walmart_coverage'); } catch (e) { return; }
    if (!raw) return;
    var data;
    try { data = JSON.parse(raw); } catch (e) { return; }
    if (!data || data.covered === null || typeof data.covered === 'undefined') return;

    document.querySelectorAll('.coverage-alert').forEach(function (el) {
      var icon = el.querySelector('.coverage-alert__icon');
      var title = el.querySelector('.coverage-alert__title');
      var text = el.querySelector('.coverage-alert__text');
      var note = el.querySelector('.coverage-alert__note');
      if (data.covered === true) {
        el.classList.add('is-covered');
        el.classList.remove('is-out');
        if (icon) icon.textContent = '✅';
        if (title) title.textContent = '¡Estás dentro de cobertura!';
        if (text) text.innerHTML = 'Tu ubicación está dentro de nuestra zona de cobertura' +
          (data.zone ? ' (<strong>' + data.zone + '</strong>)' : '') + '. Puedes continuar con tu pedido.';
        if (note) note.style.display = 'none';
      } else {
        el.classList.add('is-out');
        el.classList.remove('is-covered');
        if (icon) icon.textContent = '⚠️';
        if (title) title.textContent = 'Fuera de zona de cobertura';
        if (text) text.innerHTML = 'Tu ubicación quedó <strong>fuera</strong> de nuestra zona de cobertura. Verifica tu dirección antes de pagar.';
        if (note) note.style.display = '';
      }
    });
  }
  if (document.readyState !== 'loading') applyCoverage();
  else document.addEventListener('DOMContentLoaded', applyCoverage);
  window.addEventListener('coverageChecked', applyCoverage);
})();
</script>
