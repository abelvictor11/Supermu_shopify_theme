{%- comment -%}
  Renders PDP custom fields (select + text) as line item properties.
  Visibility is controlled by shop metafield `custom.pdp_custom_fields_config` (JSON), example:
  {
    "enabled": true,
    "visibility": { "by": "tags", "values": ["personalizable", "regalo"] },
    "select": { "label": "Categoría", "required": true, "options": ["Cumpleaños","Aniversario","Felicitación"], "placeholder": "Seleccione una opción" },
    "text": { "label": "Notas", "placeholder": "Instrucciones para el pedido...", "required": false, "maxlength": 200 }
  }

  Expected context:
  - product
  - product_form_id
{%- endcomment -%}

{%- assign _meta = shop.metafields.custom.pdp_custom_fields_config -%}
{%- assign _cfg = blank -%}
{%- if _meta != blank -%}
  {%- assign _cfg = _meta.value -%}
  {%- if _cfg == blank -%}{%- assign _cfg = _meta | parse_json -%}{%- endif -%}
{%- endif -%}

{%- assign _enabled = false -%}
{%- if _cfg and _cfg.enabled == true -%}
  {%- assign _enabled = true -%}
{%- endif -%}

{%- assign _visible = false -%}
{%- assign _vis = _cfg.visibility -%}
{%- if _vis and _vis.by == 'tags' and _vis.values -%}
  {%- assign _tags_join = product.tags | join: '|' -%}
  {%- assign _tags_str = '|' | append: _tags_join | append: '|' | downcase -%}
  {%- for t in _vis.values -%}
    {%- assign _t = t | downcase -%}
    {%- assign _needle = '|' | append: _t | append: '|' -%}
    {%- if _tags_str contains _needle -%}
      {%- assign _visible = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- assign _visible = true -%}
{%- endif -%}

{%- assign _sel = _cfg.select -%}
{%- assign _txt = _cfg.text -%}

{%- assign _sel_label = _sel.label | default: 'Categoría' -%}
{%- assign _sel_required = false -%}
{%- if _sel and _sel.required == true -%}{%- assign _sel_required = true -%}{%- endif -%}
{%- assign _sel_placeholder = _sel.placeholder | default: 'Seleccione una opción' -%}

{%- assign _txt_label = _txt.label | default: 'Notas' -%}
{%- assign _txt_required = false -%}
{%- if _txt and _txt.required == true -%}{%- assign _txt_required = true -%}{%- endif -%}
{%- assign _txt_placeholder = _txt.placeholder | default: 'Instrucciones para el pedido…' -%}
{%- assign _txt_maxlen = 200 -%}
{%- if _txt and _txt.maxlength -%}
  {%- assign _txt_maxlen = _txt.maxlength | plus: 0 -%}
{%- endif -%}

{%- if _enabled and _visible -%}
  {%- comment -%} 
    Filtrar opciones por metafield de producto: custom.cortes_disponibles
    Si el producto tiene este metafield, solo muestra los cortes listados.
    Si no tiene el metafield, muestra todas las opciones.
    Si el metafield contiene "ninguno" o está vacío con solo ese valor, no muestra el selector.
    El metafield debe ser tipo "list.single_line_text_field" con los iconos disponibles (ej: cubos, entero, filete, ninguno)
  {%- endcomment -%}
  {%- assign _product_cortes = product.metafields.custom.cortes_disponibles.value -%}
  {%- assign _has_product_filter = false -%}
  {%- assign _hide_selector = false -%}
  {%- if _product_cortes and _product_cortes.size > 0 -%}
    {%- assign _has_product_filter = true -%}
    {%- assign _product_cortes_str = _product_cortes | join: '|' | downcase -%}
    {%- comment -%} Si solo tiene "ninguno", ocultar el selector completamente {%- endcomment -%}
    {%- if _product_cortes.size == 1 and _product_cortes_str contains 'ninguno' -%}
      {%- assign _hide_selector = true -%}
    {%- endif -%}
  {%- endif -%}

  <div class="product-page-info__field product-page-info__custom-fields mb-20">
    {%- if _sel and _sel.options and _sel.options.size > 0 and _hide_selector == false -%}
      {%- assign _sel_id = 'pdp-select-' | append: section.id -%}
      {%- assign _sel_type = _sel.type | default: 'dropdown' -%}
      
      <label for="{{ _sel_id }}" class="mb-6 d-block">{{ _sel_label }}{% if _sel_required %} <span class="text-danger">*</span>{% endif %}</label>
      
      {%- if _sel_type == 'icon_grid' -%}
        {%- comment -%} Icon Grid Mode {%- endcomment -%}
        <input type="hidden" id="{{ _sel_id }}" name="properties[{{ _sel_label }}]" form="{{ product_form_id }}" value=""{% if _sel_required %} required{% endif %}>
        <div class="pdp-icon-grid" data-icon-grid-for="{{ _sel_id }}">
          {%- for opt in _sel.options -%}
            {%- assign _opt_value = opt.value | default: opt -%}
            {%- assign _opt_icon = opt.icon | default: 'default' -%}
            
            {%- comment -%} Verificar si este corte está disponible para el producto {%- endcomment -%}
            {%- assign _show_option = true -%}
            {%- if _has_product_filter -%}
              {%- assign _opt_icon_lower = _opt_icon | downcase -%}
              {%- unless _product_cortes_str contains _opt_icon_lower -%}
                {%- assign _show_option = false -%}
              {%- endunless -%}
            {%- endif -%}
            
            {%- if _show_option -%}
              <button type="button" class="pdp-icon-grid__item" data-value="{{ _opt_value | strip }}" title="{{ _opt_value }}">
                <span class="pdp-icon-grid__icon pdp-icon-grid__icon--{{ _opt_icon }}"></span>
                <span class="pdp-icon-grid__label">{{ _opt_value }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if _sel_required -%}
          <p class="pdp-icon-grid__error d-none text-danger mt-5 mb-0" style="font-size: 12px;">Por favor seleccione una opción</p>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Dropdown Mode (default) {%- endcomment -%}
        <select id="{{ _sel_id }}" name="properties[{{ _sel_label }}]" form="{{ product_form_id }}" class="mb-10"{% if _sel_required %} required{% endif %}>
          <option value="" disabled selected>{{ _sel_placeholder }}</option>
          {%- for opt in _sel.options -%}
            {%- assign _opt_value = opt.value | default: opt -%}
            {%- assign _opt_icon = opt.icon | default: 'default' -%}
            
            {%- comment -%} Verificar si este corte está disponible para el producto {%- endcomment -%}
            {%- assign _show_option = true -%}
            {%- if _has_product_filter -%}
              {%- assign _opt_icon_lower = _opt_icon | downcase -%}
              {%- unless _product_cortes_str contains _opt_icon_lower -%}
                {%- assign _show_option = false -%}
              {%- endunless -%}
            {%- endif -%}
            
            {%- if _show_option -%}
              <option value="{{ _opt_value | strip }}">{{ _opt_value }}</option>
            {%- endif -%}
          {%- endfor -%}
        </select>
      {%- endif -%}
    {%- endif -%}

    {%- unless _hide_selector -%}
      {%- assign _txt_id = 'pdp-text-' | append: section.id -%}
      <label for="{{ _txt_id }}" class="mb-6">{{ _txt_label }}</label>
      <textarea id="{{ _txt_id }}" name="properties[{{ _txt_label }}]" form="{{ product_form_id }}" placeholder="{{ _txt_placeholder }}" maxlength="{{ _txt_maxlen }}" class="mb-0"{% if _txt_required %} required{% endif %}></textarea>
    {%- endunless -%}
  </div>

  {%- if _sel_type == 'icon_grid' -%}
  <style>
    .pdp-icon-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 15px;
    }
    @media (min-width: 768px) {
      .pdp-icon-grid {
        grid-template-columns: repeat(6, 1fr);
      }
    }
    .pdp-icon-grid__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 12px 8px;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      background: #fff;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .pdp-icon-grid__item:hover {
      border-color: #999;
      background: #f8f8f8;
    }
    .pdp-icon-grid__item.is-selected {
      border-color: #c8102e;
      background: #fef2f2;
    }
    .pdp-icon-grid__icon {
      width: 40px;
      height: 40px;
      margin-bottom: 6px;
      background-size: contain;
      background-repeat: no-repeat;
      background-position: center;
    }
    /* Iconos de cortes de carne */
    .pdp-icon-grid__icon--cubos { background-image: url('https://cdn.shopify.com/s/files/1/0727/5036/6971/files/cubos.svg?v=1767646678'); }
    .pdp-icon-grid__icon--entero { background-image: url('https://cdn.shopify.com/s/files/1/0727/5036/6971/files/entero.svg?v=1767646669'); }
    .pdp-icon-grid__icon--mariposa { background-image: url('https://cdn.shopify.com/s/files/1/0727/5036/6971/files/mariposa.svg?v=1767646669'); }
    .pdp-icon-grid__icon--filete { background-image: url('https://cdn.shopify.com/s/files/1/0727/5036/6971/files/sencillo.svg?v=1767646669'); }
    .pdp-icon-grid__icon--tiras { background-image: url('https://cdn.shopify.com/s/files/1/0727/5036/6971/files/julianas.svg?v=1767646669'); }
    .pdp-icon-grid__icon--goulash { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="6" y="12" width="14" height="10" rx="2" fill="%23c8102e" transform="rotate(15 13 17)"/><rect x="24" y="8" width="14" height="10" rx="2" fill="%23c8102e" transform="rotate(-10 31 13)"/><rect x="44" y="14" width="14" height="10" rx="2" fill="%23c8102e" transform="rotate(5 51 19)"/><rect x="10" y="32" width="14" height="10" rx="2" fill="%23c8102e" transform="rotate(-5 17 37)"/><rect x="28" y="30" width="14" height="10" rx="2" fill="%23c8102e" transform="rotate(12 35 35)"/><rect x="46" y="34" width="14" height="10" rx="2" fill="%23c8102e" transform="rotate(-8 53 39)"/><rect x="18" y="50" width="14" height="10" rx="2" fill="%23c8102e" transform="rotate(8 25 55)"/><rect x="38" y="48" width="14" height="10" rx="2" fill="%23c8102e" transform="rotate(-12 45 53)"/></svg>'); }
    .pdp-icon-grid__icon--default { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="24" fill="%23c8102e"/></svg>'); }
    .pdp-icon-grid__label {
      font-size: 11px;
      text-align: center;
      color: #333;
      line-height: 1.2;
    }
    .pdp-icon-grid__item.is-selected .pdp-icon-grid__label {
      font-weight: 600;
      color: #c8102e;
    }
  </style>
  <script>
    (function() {
      document.querySelectorAll('.pdp-icon-grid').forEach(function(grid) {
        var inputId = grid.dataset.iconGridFor;
        var input = document.getElementById(inputId);
        var items = grid.querySelectorAll('.pdp-icon-grid__item');
        var errorMsg = grid.nextElementSibling;
        
        items.forEach(function(item) {
          item.addEventListener('click', function() {
            // Remove selection from all
            items.forEach(function(i) { i.classList.remove('is-selected'); });
            // Select this one
            item.classList.add('is-selected');
            // Update hidden input
            input.value = item.dataset.value;
            // Hide error if shown
            if (errorMsg && errorMsg.classList.contains('pdp-icon-grid__error')) {
              errorMsg.classList.add('d-none');
            }
          });
        });

        // Validation on form submit
        var form = input.form;
        if (form && input.required) {
          form.addEventListener('submit', function(e) {
            if (!input.value) {
              e.preventDefault();
              if (errorMsg) errorMsg.classList.remove('d-none');
              grid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          });
        }
      });
    })();
  </script>
  {%- endif -%}
{%- endif -%}
