{%- assign has_compare_price = product.compare_at_price -%}
{%- assign max_quantity = product.stock -%}  

{%- if has_compare_price and product.compare_at_price > product.price %}
    {%- assign max_quantity = 3 -%}  
{%- endif %}

{%- assign cart_limits_enabled = false -%}
{%- assign cart_item_max = 0 -%}
{%- assign _cl_meta = shop.metafields.custom.cart_limits -%}
{%- if _cl_meta == blank -%}{%- assign _cl_meta = shop.metafields.custom.cart_item_max_quantity -%}{%- endif -%}
{%- assign _cl = nil -%}
{%- if _cl_meta != blank -%}
  {%- assign _cl = _cl_meta.value -%}
  {%- if _cl.enabled == blank and _cl.max_per_line == blank -%}
    {%- assign _cl = _cl_meta.value | parse_json -%}
  {%- endif -%}
  {%- if _cl.enabled == true -%}
    {%- assign cart_item_max = _cl.max_per_line | plus: 0 -%}
    {%- assign cart_limits_enabled = true -%}
  {%- elsif _cl.enabled != blank -%}
    {%- assign _cl_enabled_str = _cl.enabled | downcase | strip -%}
    {%- if _cl_enabled_str == "true" -%}
      {%- assign cart_item_max = _cl.max_per_line | plus: 0 -%}
      {%- assign cart_limits_enabled = true -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if cart_limits_enabled and cart_item_max < 1 -%}{%- assign cart_item_max = 3 -%}{%- endif -%}
{%- if cart_limits_enabled and _cl.tag_limits != blank -%}
  {%- assign _found_tag_limit = false -%}
  {%- for _tag_rule in _cl.tag_limits -%}
    {%- unless _found_tag_limit -%}
      {%- assign _rule_tag_lower = _tag_rule.tag | downcase | strip -%}
      {%- for _ptag in product.tags -%}
        {%- assign _ptag_lower = _ptag | downcase | strip -%}
        {%- if _ptag_lower == _rule_tag_lower -%}
          {%- assign cart_item_max = _tag_rule.max_per_line | plus: 0 -%}
          {%- assign _found_tag_limit = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endif -%}
{%- assign _inv_variant = product.selected_or_first_available_variant -%}
{%- if _inv_variant.inventory_policy == 'deny' and _inv_variant.inventory_quantity > 0 -%}
  {%- if cart_limits_enabled -%}
    {%- if _inv_variant.inventory_quantity < cart_item_max -%}
      {%- assign cart_item_max = _inv_variant.inventory_quantity -%}
    {%- endif -%}
  {%- else -%}
    {%- assign cart_item_max = _inv_variant.inventory_quantity -%}
    {%- assign cart_limits_enabled = true -%}
  {%- endif -%}
{%- endif -%}

{%- assign quantity_type = quantity_type | default: 1 -%}
{%- case quantity_type -%}
    {%- when 1 %}
        <label{% unless quantity_show_title %} class="d-none"{% endunless %}>{{ 'products.product.quantity' | t }}</label>
        <div class="input-quantity input-quantity--type-01 d-flex js-product-quantity"{% if quantity_connect %} data-js-quantity-connect="{{ quantity_connect }}"{% endif %}>
            <input type="number" class="mb-0 mr-10" name="quantity" value="1" min="1" {% if cart_limits_enabled %}max="{{ cart_item_max }}"{% endif %} oninput="{% if cart_limits_enabled %}this.value = Math.min({{ cart_item_max }}, Math.max(1, this.value)){% else %}this.value = Math.max(1, this.value){% endif %}" {% if product_form_id %} form="{{ product_form_id }}"{% endif %}>
            <div class="d-flex flex-center mr-10 border cursor-pointer" data-control="-"><i>{% render 'icon-theme-189' %}</i></div>
            <div class="d-flex flex-center border cursor-pointer" data-control="+"><i>{% render 'icon-theme-188' %}</i></div>
        </div>
    {%- when 2 %}
        <label{% unless quantity_show_title %} class="d-none"{% endunless %}>{{ 'products.product.quantity' | t }}</label>
        <div class="input-quantity input-quantity--type-02 d-flex js-product-quantity"{% if quantity_connect %} data-js-quantity-connect="{{ quantity_connect }}"{% endif %}>
            <div class="d-flex flex-center cursor-pointer" data-control="-"><i>{% render 'icon-theme-189' %}</i></div>
            <input type="number" class="mb-0 text-center" name="quantity" value="1" min="1" {% if cart_limits_enabled %}max="{{ cart_item_max }}"{% endif %} oninput="{% if cart_limits_enabled %}this.value = Math.min({{ cart_item_max }}, Math.max(1, this.value)){% else %}this.value = Math.max(1, this.value){% endif %}" {% if product_form_id %} form="{{ product_form_id }}"{% endif %}>
            <div class="d-flex flex-center cursor-pointer" data-control="+"><i>{% render 'icon-theme-188' %}</i></div>
        </div>
    {%- when 3 %}
        <label{% unless quantity_show_title %} class="d-none"{% endunless %}>{{ 'products.product.quantity' | t }}</label>
        <div class="input-quantity input-quantity--type-03 d-flex mr-10 js-product-quantity"{% if quantity_connect %} data-js-quantity-connect="{{ quantity_connect }}"{% endif %}>
            <input type="number" class="mb-0" name="quantity" value="1" min="1" {% if cart_limits_enabled %}max="{{ cart_item_max }}"{% endif %} oninput="{% if cart_limits_enabled %}this.value = Math.min({{ cart_item_max }}, Math.max(1, this.value)){% else %}this.value = Math.max(1, this.value){% endif %}" {% if product_form_id %} form="{{ product_form_id }}"{% endif %}>
        </div>
    {%- when 4 %}
        <label{% unless quantity_show_title %} class="d-none"{% endunless %}>{{ 'products.product.quantity' | t }}</label>
        <div class="input-quantity input-quantity--type-04 d-flex align-items-center position-relative mr-10 js-product-quantity"{% if quantity_connect %} data-js-quantity-connect="{{ quantity_connect }}"{% endif %}>
            <div class="d-flex flex-center position-absolute left-0 ml-10 cursor-pointer" data-control="-"><i>{% render 'icon-theme-189' %}</i></div>
            <input type="number" class="mb-0 px-35 text-center" name="quantity" value="1" min="1" {% if cart_limits_enabled %}max="{{ cart_item_max }}"{% endif %} oninput="{% if cart_limits_enabled %}this.value = Math.min({{ cart_item_max }}, Math.max(1, this.value)){% else %}this.value = Math.max(1, this.value){% endif %}" {% if product_form_id %} form="{{ product_form_id }}"{% endif %}>
            <div class="d-flex flex-center position-absolute right-0 mr-10 cursor-pointer" data-control="+"><i>{% render 'icon-theme-188' %}</i></div>
        </div>
    {%- when 5 %}
        <label{% unless quantity_show_title %} class="d-none"{% endunless %}>{{ 'products.product.quantity' | t }}</label>
        <div class="input-quantity input-quantity--type-05 d-flex js-product-quantity"{% if quantity_connect %} data-js-quantity-connect="{{ quantity_connect }}"{% endif %}>
            <div class="d-flex flex-center border cursor-pointer" data-control="-"><i>{% render 'icon-theme-189' %}</i></div>
            <input type="number" class="mx-10 mb-0 text-center" name="quantity" value="1" min="1" {% if cart_limits_enabled %}max="{{ cart_item_max }}"{% endif %} oninput="{% if cart_limits_enabled %}this.value = Math.min({{ cart_item_max }}, Math.max(1, this.value)){% else %}this.value = Math.max(1, this.value){% endif %}" {% if product_form_id %} form="{{ product_form_id }}"{% endif %}>
            <div class="d-flex flex-center border cursor-pointer" data-control="+"><i>{% render 'icon-theme-188' %}</i></div>
        </div>
{%- endcase -%}