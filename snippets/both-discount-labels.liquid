{%- comment -%}
Renders both discount labels (if applicable):
- Red: day-specific rules (daily-discount-label)
- Green: collection metafield rules (discount-label)
Usage:
  {% render 'both-discount-labels', product: product %}
{%- endcomment -%}
{%- assign _product = product -%}
{%- if _product -%}
  {%- capture _gp -%}{% render 'discount-label', product: _product, mode: 'percent', collection: collection %}{%- endcapture -%}
  {%- capture _rp -%}{% render 'daily-discount-label', product: _product, mode: 'percent' %}{%- endcapture -%}
  {%- assign gp = _gp | strip | remove: '%' | plus: 0 -%}
  {%- assign rp = _rp | strip | remove: '%' | plus: 0 -%}

  {%- assign _winner = '' -%}
  {%- if rp > 0 or gp > 0 -%}
    {%- if rp > gp and rp > 0 -%}
      {%- assign _winner = 'red' -%}
      {% render 'daily-discount-label', product: _product %}
    {%- elsif gp > rp and gp > 0 -%}
      {%- assign _winner = 'green' -%}
      {% render 'discount-label', product: _product, collection: collection %}
    {%- elsif rp == gp and rp > 0 -%}
      {%- assign _winner = 'red' -%}
      {% render 'daily-discount-label', product: _product %}
    {%- endif -%}
  {%- endif -%}

  {%- if request.design_mode -%}
    <div style="font-size:11px;color:#777;margin-top:6px;">(both-discount-labels debug) gp={{ gp }} rp={{ rp }} winner={{ _winner }} | raw_g='{{ _gp | strip }}' raw_r='{{ _rp | strip }}'</div>
  {%- endif -%}
{%- endif -%}
