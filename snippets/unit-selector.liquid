{%- comment -%}
Selector de unidades para productos vendidos por peso/unidad.
Convierte automáticamente a kilos para SIESA manteniendo un solo SKU.

Metafields requeridos (producto):
  - custom.price_per_kilo (number) - Precio base por kilo EN CENTAVOS
  - custom.unit_weight (number, opcional) - Peso promedio de 1 unidad en kg (ej: 0.15 para 150g)

Usage:
  {% render 'unit-selector', product: product, variant: current_variant, context: 'pdp' %}
  {% render 'unit-selector', product: product, variant: current_variant, context: 'collection' %}
{%- endcomment -%}

{%- assign price_per_kilo_meta = product.metafields.custom.price_per_kilo -%}

{%- comment -%} Solo mostrar si existe price_per_kilo {%- endcomment -%}
{%- if price_per_kilo_meta != blank -%}
  {%- assign price_per_kilo = price_per_kilo_meta | plus: 0 -%}
  {%- assign unit_weight = product.metafields.custom.unit_weight | default: 0.15 | plus: 0 -%}
  {%- assign variant_id = variant.id | default: product.selected_or_first_available_variant.id -%}
  {%- assign selector_context = context | default: 'pdp' -%}
  
  {%- comment -%} Calcular precios para cada presentación {%- endcomment -%}
  {%- assign price_kg = price_per_kilo -%}
  {%- assign price_lb = price_per_kilo | times: 0.45359 | round -%}
  {%- assign price_unit = price_per_kilo | times: unit_weight | round -%}
  
  <div class="unit-selector" 
       data-product-id="{{ product.id }}" 
       data-variant-id="{{ variant_id }}"
       data-price-per-kilo="{{ price_per_kilo }}"
       data-unit-weight="{{ unit_weight }}"
       data-context="{{ selector_context }}">
    
    <label class="unit-selector__label">Presentación:</label>
    
    <div class="unit-selector__options">
      <button type="button" 
              class="unit-selector__option active" 
              data-unit="kg" 
              data-multiplier="1"
              data-price="{{ price_kg }}">
        <span class="unit-selector__option-name">Kilo</span>
        <span class="unit-selector__option-price">{{ price_kg | money }}</span>
      </button>
      
      <button type="button" 
              class="unit-selector__option" 
              data-unit="lb" 
              data-multiplier="0.45359"
              data-price="{{ price_lb }}">
        <span class="unit-selector__option-name">Libra</span>
        <span class="unit-selector__option-price">{{ price_lb | money }}</span>
      </button>
      
      <button type="button" 
              class="unit-selector__option" 
              data-unit="unidad" 
              data-multiplier="{{ unit_weight }}"
              data-price="{{ price_unit }}">
        <span class="unit-selector__option-name">Unidad</span>
        <span class="unit-selector__option-price">{{ price_unit | money }}</span>
      </button>
    </div>
    
    {%- comment -%} Campos ocultos - se copiarán al form del PDP vía JS {%- endcomment -%}
    <input type="hidden" 
           class="unit-selector__selected-unit" 
           name="properties[Presentación]" 
           value="Kilo">
    
    <input type="hidden" 
           class="unit-selector__selected-multiplier" 
           data-multiplier-value
           value="1">
           
    <input type="hidden"
           class="unit-selector__selected-price"
           data-selected-price
           value="{{ price_kg }}">
  </div>
  
  <style>
    .unit-selector {
      margin-bottom: 15px;
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }
    
    .unit-selector__label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
      color: #333;
      font-size: 13px;
    }
    
    .unit-selector__options {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      width: 100%;
    }
    
    .unit-selector__option {
      background: white;
      border: 2px solid #e0e0e0;
      border-radius: 6px;
      padding: 8px 4px;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      min-width: 0;
      overflow: hidden;
    }
    
    .unit-selector__option:hover {
      border-color: #667eea;
      background: #f8f9ff;
    }
    
    .unit-selector__option.active {
      border-color: #667eea;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    
    .unit-selector__option-name {
      font-size: 11px;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
      text-align: center;
    }
    
    .unit-selector__option-price {
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
      text-align: center;
    }
    
    @media (max-width: 640px) {
      .unit-selector__options {
        grid-template-columns: 1fr;
      }
      
      .unit-selector__option {
        flex-direction: row;
        justify-content: space-between;
      }
    }
  </style>
{%- endif -%}
