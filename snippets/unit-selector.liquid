{%- comment -%}
Selector de unidades para productos vendidos por peso/unidad.
Usa VARIANTS para cada presentación (Kilo, Libra, Unidad).

Configuración en Shopify:
  1. Crear opción "Presentación" con valores: Kilo, Libra, Unidad
  2. Crear variants con precios correspondientes:
     - Kilo: precio base (ej: $7,500)
     - Libra: precio × 0.45359 (ej: $3,402)
     - Unidad: precio × peso_unidad (ej: $1,125 para 150g)

El selector detecta automáticamente si el producto tiene variants de presentación.
Si no los tiene, no muestra el selector.

Usage:
  {% render 'unit-selector', product: product, variant: current_variant, context: 'pdp' %}
  {% render 'unit-selector', product: product, variant: current_variant, context: 'collection' %}
{%- endcomment -%}

{%- assign selector_context = context | default: 'pdp' -%}
{%- assign current_variant = variant | default: product.selected_or_first_available_variant -%}

{%- comment -%} Detectar si el producto tiene variants de presentación {%- endcomment -%}
{%- assign has_presentation_option = false -%}
{%- assign presentation_option_index = nil -%}
{%- for option in product.options_with_values -%}
  {%- assign option_name_lower = option.name | downcase -%}
  {%- if option_name_lower == 'presentación' or option_name_lower == 'presentacion' -%}
    {%- assign has_presentation_option = true -%}
    {%- assign presentation_option_index = forloop.index0 -%}
    {%- assign presentation_values = option.values -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Solo mostrar si tiene opción de presentación {%- endcomment -%}
{%- if has_presentation_option -%}
  
  {%- comment -%} Mapear valores de presentación a variants {%- endcomment -%}
  {%- assign variant_kilo = nil -%}
  {%- assign variant_libra = nil -%}
  {%- assign variant_unidad = nil -%}
  
  {%- for v in product.variants -%}
    {%- assign v_option = v.options[presentation_option_index] | downcase -%}
    {%- if v_option == 'kilo' or v_option == 'kg' -%}
      {%- assign variant_kilo = v -%}
    {%- elsif v_option == 'libra' or v_option == 'lb' -%}
      {%- assign variant_libra = v -%}
    {%- elsif v_option == 'unidad' or v_option == 'un' or v_option == 'und' -%}
      {%- assign variant_unidad = v -%}
    {%- endif -%}
  {%- endfor -%}
  
  {%- comment -%} Determinar cuál está activo {%- endcomment -%}
  {%- assign current_option = current_variant.options[presentation_option_index] | downcase -%}
  {%- assign active_kilo = false -%}
  {%- assign active_libra = false -%}
  {%- assign active_unidad = false -%}
  
  {%- if current_option == 'kilo' or current_option == 'kg' -%}
    {%- assign active_kilo = true -%}
  {%- elsif current_option == 'libra' or current_option == 'lb' -%}
    {%- assign active_libra = true -%}
  {%- elsif current_option == 'unidad' or current_option == 'un' or current_option == 'und' -%}
    {%- assign active_unidad = true -%}
  {%- else -%}
    {%- assign active_kilo = true -%}
  {%- endif -%}
  
  <div class="unit-selector" 
       data-product-id="{{ product.id }}" 
       data-variant-id="{{ current_variant.id }}"
       data-context="{{ selector_context }}"
       data-use-variants="true">
    
    <label class="unit-selector__label">Presentación:</label>
    
    <div class="unit-selector__options">
      {%- if variant_kilo -%}
        <button type="button" 
                class="unit-selector__option{% if active_kilo %} active{% endif %}" 
                data-unit="kilo"
                data-variant-id="{{ variant_kilo.id }}"
                data-price="{{ variant_kilo.price }}"
                {% unless variant_kilo.available %}disabled{% endunless %}>
          <span class="unit-selector__option-name">Kilo</span>
          <span class="unit-selector__option-price">{{ variant_kilo.price | money }}</span>
        </button>
      {%- endif -%}
      
      {%- if variant_libra -%}
        <button type="button" 
                class="unit-selector__option{% if active_libra %} active{% endif %}" 
                data-unit="libra"
                data-variant-id="{{ variant_libra.id }}"
                data-price="{{ variant_libra.price }}"
                {% unless variant_libra.available %}disabled{% endunless %}>
          <span class="unit-selector__option-name">Libra</span>
          <span class="unit-selector__option-price">{{ variant_libra.price | money }}</span>
        </button>
      {%- endif -%}
      
      {%- if variant_unidad -%}
        <button type="button" 
                class="unit-selector__option{% if active_unidad %} active{% endif %}" 
                data-unit="unidad"
                data-variant-id="{{ variant_unidad.id }}"
                data-price="{{ variant_unidad.price }}"
                {% unless variant_unidad.available %}disabled{% endunless %}>
          <span class="unit-selector__option-name">Unidad</span>
          <span class="unit-selector__option-price">{{ variant_unidad.price | money }}</span>
        </button>
      {%- endif -%}
    </div>
    
    {%- comment -%} Campo oculto para la presentación seleccionada {%- endcomment -%}
    <input type="hidden" 
           class="unit-selector__selected-unit" 
           name="properties[Presentación]" 
           value="{% if active_kilo %}Kilo{% elsif active_libra %}Libra{% elsif active_unidad %}Unidad{% endif %}">
  </div>
  
  <style>
    .unit-selector {
      margin-bottom: 15px;
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }
    
    .unit-selector__label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
      color: #333;
      font-size: 13px;
    }
    
    .unit-selector__options {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      width: 100%;
    }
    
    .unit-selector__option {
      background: white;
      border: 2px solid #e0e0e0;
      border-radius: 6px;
      padding: 8px 4px;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      min-width: 0;
      overflow: hidden;
    }
    
    .unit-selector__option:hover {
      border-color: #667eea;
      background: #f8f9ff;
    }
    
    .unit-selector__option.active {
      border-color: #667eea;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    
    .unit-selector__option-name {
      font-size: 11px;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
      text-align: center;
    }
    
    .unit-selector__option-price {
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
      text-align: center;
    }
    
    @media (max-width: 640px) {
      .unit-selector__options {
        grid-template-columns: 1fr;
      }
      
      .unit-selector__option {
        flex-direction: row;
        justify-content: space-between;
      }
    }
  </style>
{%- endif -%}
