{% comment %}
  Store Selector - Estilo Walmart
  Módulo en header con dropdown y modal lateral
{% endcomment %}

<!-- Dropdown principal (se muestra al hacer click en el botón del header) -->
<div id="store-selector-dropdown" class="walmart-store-dropdown" style="display: none;">
  <div class="walmart-dropdown-content">
    <!-- Icono de cerrar -->
    <button class="walmart-dropdown-close" aria-label="Cerrar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Título -->
    <div class="walmart-dropdown-header">
      <div class="walmart-icon-delivery">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="#FF0203"/>
          <circle cx="12" cy="9" r="2.5" fill="white"/>
        </svg>
      </div>
      <h2>¿Retiro o entrega?</h2>
    </div>

    <!-- Tres opciones: Envío, Retiro, Entrega -->
    <div class="walmart-options-grid">
      <div class="walmart-option" data-option="envio">
        <div class="walmart-option-icon">
          <svg width="48" height="48" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="28" fill="#FF0203"/>
            <path d="M25 35l7 7 15-15" stroke="white" stroke-width="3" fill="none"/>
            <rect x="16" y="20" width="24" height="16" rx="2" fill="white" opacity="0.3"/>
            <path d="M20 22h16M20 26h12M20 30h14" stroke="white" stroke-width="1.5"/>
          </svg>
        </div>
        <span>Envío</span>
      </div>
      
      <div class="walmart-option walmart-option-selected" data-option="retiro">
        <div class="walmart-option-icon">
          <svg width="48" height="48" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="28" fill="#FF0203"/>
            <path d="M24 38h16M28 38v-6M36 38v-6" stroke="white" stroke-width="2.5"/>
            <rect x="20" y="24" width="24" height="8" rx="1" fill="white"/>
            <circle cx="28" cy="42" r="2" fill="white"/>
            <circle cx="36" cy="42" r="2" fill="white"/>
          </svg>
        </div>
        <span>Retiro</span>
      </div>
      
      <div class="walmart-option" data-option="entrega">
        <div class="walmart-option-icon">
          <svg width="48" height="48" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="28" fill="#FF0203"/>
            <rect x="20" y="26" width="12" height="14" rx="1" fill="white"/>
            <path d="M26 32v-6l6 3-6 3z" fill="#FF0203"/>
            <rect x="34" y="30" width="8" height="6" fill="white" opacity="0.7"/>
          </svg>
        </div>
        <span>Entrega</span>
      </div>
    </div>

    <!-- Campo de dirección -->
    <div class="walmart-address-section">
      <div class="walmart-address-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </div>
      <div class="walmart-address-input-wrapper">
        <label>Agrega una dirección para el envío y la entrega</label>
        <input 
          type="text" 
          id="walmart-address-input" 
          placeholder="Ingresa ciudad o código postal"
          class="walmart-address-input"
        >
      </div>
    </div>

    <!-- Botón para usar geolocalización -->
    <button class="walmart-btn-location" id="walmart-use-location">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <circle cx="12" cy="12" r="3"></circle>
        <line x1="12" y1="2" x2="12" y2="6"></line>
        <line x1="12" y1="18" x2="12" y2="22"></line>
        <line x1="2" y1="12" x2="6" y2="12"></line>
        <line x1="18" y1="12" x2="22" y2="12"></line>
      </svg>
      Usar mi ubicación actual
    </button>

    <!-- Tienda sugerida/seleccionada -->
    <div class="walmart-suggested-store" id="walmart-suggested-store" style="display: none;">
      <div class="walmart-store-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="#FF0203">
          <path d="M12 2l9 4v6c0 5.55-3.84 10.74-9 12-5.16-1.26-9-6.45-9-12V6l9-4z"/>
          <path d="M10 17l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" fill="white"/>
        </svg>
      </div>
      <div class="walmart-store-info">
        <h4 id="walmart-store-name">Tienda</h4>
        <p id="walmart-store-address">Dirección</p>
      </div>
      <button class="walmart-store-arrow" onclick="window.storeSelector.openStoreModal()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Botón para agregar dirección -->
    <button class="walmart-btn-primary" id="walmart-add-address" style="display: none;">
      Agregar dirección
    </button>

    <!-- Link para ver todas las tiendas -->
    <button class="walmart-link-stores" onclick="window.storeSelector.openStoreModal()">
      Ver todas las tiendas disponibles
    </button>
  </div>
</div>

<!-- Modal lateral para elegir tienda -->
<div id="store-selector-modal" class="walmart-store-modal" style="display: none;">
  <div class="walmart-modal-overlay"></div>
  <div class="walmart-modal-content">
    <!-- Header del modal -->
    <div class="walmart-modal-header">
      <h2>Elige una tienda</h2>
      <button class="walmart-modal-close" aria-label="Cerrar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Búsqueda -->
    <div class="walmart-modal-search">
      <label>Ingresa un código postal o una ciudad y estado</label>
      <div class="walmart-search-wrapper">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="walmart-modal-search-input"
          placeholder="Ciudad, código postal"
          class="walmart-modal-search-input"
        >
      </div>
      <button class="walmart-btn-location-modal" id="walmart-use-location-modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        Usar mi ubicación actual
      </button>
      <p class="walmart-geolocation-status" id="walmart-geo-status"></p>
    </div>

    <!-- Lista de tiendas -->
    <div class="walmart-modal-stores" id="walmart-modal-stores">
      <div class="walmart-stores-loading">
        <div class="walmart-spinner"></div>
        <p>Cargando tiendas...</p>
      </div>
    </div>

    <!-- Footer del modal -->
    <div class="walmart-modal-footer">
      <button class="walmart-btn-secondary" onclick="window.storeSelector.closeStoreModal()">
        Cancelar
      </button>
      <button class="walmart-btn-save" id="walmart-save-store" disabled>
        Guardar
      </button>
    </div>
  </div>
</div>

<script>
  window.STORE_DIRECTORY_URL = '/pages/store-directory';
</script>
