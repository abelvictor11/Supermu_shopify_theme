{%- comment -%}
  Sidebar Menu - Menú lateral deslizante
  Uso: {% render 'sidebar-menu' %}
  
  Configuración desde Theme Settings:
  - sidebar_menu_handle: Handle del menú de Shopify
  - sidebar_menu_button_text: Texto del botón
{%- endcomment -%}

{%- assign menu_handle = settings.sidebar_menu_handle | default: 'main-menu' -%}
{%- assign button_text = settings.sidebar_menu_button_text | default: 'Menú' -%}
{%- assign menu = linklists[menu_handle] -%}

{%- if menu.links.size > 0 -%}

{%- comment -%} Botón trigger {%- endcomment -%}
<button class="sidebar-menu-trigger" data-sidebar-menu-open aria-label="Abrir menú">
  <span class="sidebar-menu-trigger__icon">
    <span></span>
    <span></span>
    <span></span>
  </span>
  <span class="sidebar-menu-trigger__text">{{ button_text }}</span>
</button>

{%- comment -%} Overlay {%- endcomment -%}
<div class="sidebar-menu-overlay" data-sidebar-menu-overlay></div>

{%- comment -%} Sidebar {%- endcomment -%}
<div class="sidebar-menu" data-sidebar-menu>
  <div class="sidebar-menu__header">
    <button class="sidebar-menu__close" data-sidebar-menu-close aria-label="Cerrar menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  
  <nav class="sidebar-menu__nav">
    <ul class="sidebar-menu__list sidebar-menu__list--level-0" data-menu-level="0">
      {%- for link in menu.links -%}
        <li class="sidebar-menu__item{% if link.links.size > 0 %} has-children{% endif %}">
          {%- if link.links.size > 0 -%}
            <div class="sidebar-menu__link-wrapper">
              <a href="{{ link.url }}" class="sidebar-menu__link">{% render 'sidebar-menu-icon', link: link %}{{ link.title }}</a>
              <button class="sidebar-menu__toggle" data-menu-toggle aria-label="Expandir {{ link.title }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
            
            {%- comment -%} Nivel 2 {%- endcomment -%}
            <ul class="sidebar-menu__list sidebar-menu__list--level-1" data-menu-level="1">
              <li class="sidebar-menu__item sidebar-menu__item--back">
                <button class="sidebar-menu__back" data-menu-back>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                  <span>Volver</span>
                </button>
              </li>
              <li class="sidebar-menu__item sidebar-menu__item--title">
                <a href="{{ link.url }}" class="sidebar-menu__link sidebar-menu__link--title">{{ link.title }}</a>
              </li>
              {%- for child_link in link.links -%}
                <li class="sidebar-menu__item{% if child_link.links.size > 0 %} has-children{% endif %}">
                  {%- if child_link.links.size > 0 -%}
                    <div class="sidebar-menu__link-wrapper">
                      <a href="{{ child_link.url }}" class="sidebar-menu__link">{% render 'sidebar-menu-icon', link: child_link %}{{ child_link.title }}</a>
                      <button class="sidebar-menu__toggle" data-menu-toggle aria-label="Expandir {{ child_link.title }}">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </button>
                    </div>
                    
                    {%- comment -%} Nivel 3 {%- endcomment -%}
                    <ul class="sidebar-menu__list sidebar-menu__list--level-2" data-menu-level="2">
                      <li class="sidebar-menu__item sidebar-menu__item--back">
                        <button class="sidebar-menu__back" data-menu-back>
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                          </svg>
                          <span>Volver</span>
                        </button>
                      </li>
                      <li class="sidebar-menu__item sidebar-menu__item--title">
                        <a href="{{ child_link.url }}" class="sidebar-menu__link sidebar-menu__link--title">{{ child_link.title }}</a>
                      </li>
                      {%- for grandchild_link in child_link.links -%}
                        <li class="sidebar-menu__item">
                          <a href="{{ grandchild_link.url }}" class="sidebar-menu__link">{% render 'sidebar-menu-icon', link: grandchild_link %}{{ grandchild_link.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    <a href="{{ child_link.url }}" class="sidebar-menu__link">{% render 'sidebar-menu-icon', link: child_link %}{{ child_link.title }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <a href="{{ link.url }}" class="sidebar-menu__link">{% render 'sidebar-menu-icon', link: link %}{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</div>

<style>
/* Trigger Button - Solo visible en desktop */
.sidebar-menu-trigger {
  display: none; /* Oculto en móviles */
  align-items: center;
  gap: 8px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px 12px;
  font-size: 14px;
  font-weight: 600;
  color: inherit;
  transition: opacity 0.2s;
}

@media (min-width: 1025px) {
  .sidebar-menu-trigger {
    display: flex; /* Visible solo en desktop */
  }
}

.sidebar-menu-trigger:hover { opacity: 0.7; }

.sidebar-menu-trigger__icon {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 20px;
  height: 14px;
}
.sidebar-menu-trigger__icon span {
  display: block;
  height: 2px;
  background: currentColor;
  border-radius: 1px;
  transition: all 0.3s;
}

.sidebar-menu-trigger__text {
  display: inline;
}

/* Overlay */
.sidebar-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
  z-index: 9998;
}
.sidebar-menu-overlay.is-active {
  opacity: 1;
  visibility: visible;
}

/* Sidebar */
.sidebar-menu {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  max-width: 380px;
  height: 100%;
  background: #fff;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.sidebar-menu.is-active {
  transform: translateX(0);
}

.sidebar-menu__header {
  display: flex;
  justify-content: flex-end;
  padding: 15px 20px;
  border-bottom: 1px solid #eee;
}

.sidebar-menu__close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
  color: #333;
  transition: color 0.2s;
}
.sidebar-menu__close:hover { color: #000; }

/* Navigation */
.sidebar-menu__nav {
  flex: 1;
  overflow-x: hidden;
  overflow-y: auto;
  position: relative;
}

.sidebar-menu__list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.sidebar-menu__list li::before {
  display: none !important;
  content: none !important;
}

.sidebar-menu__item::before {
  display: none !important;
  content: none !important;
}

.sidebar-menu__list--level-0 {
  padding: 10px 0;
}

.sidebar-menu__list--level-1,
.sidebar-menu__list--level-2 {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #fff;
  transform: translateX(100%);
  transition: transform 0.3s ease;
  overflow-y: auto;
  padding: 10px 0;
}

.sidebar-menu__list--level-1.is-active,
.sidebar-menu__list--level-2.is-active {
  transform: translateX(0);
}

.sidebar-menu__item {
  border-bottom: 1px solid #f5f5f5;
}

.sidebar-menu__item--back {
  background: #f8f8f8;
  border-bottom: 1px solid #eee;
}

.sidebar-menu__item--title {
  background: #f0f0f0;
}

.sidebar-menu__link-wrapper {
  display: flex;
  align-items: center;
}

.sidebar-menu__link {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  padding: 15px 20px;
  color: #333;
  text-decoration: none;
  font-size: 15px;
  transition: background 0.2s, color 0.2s;
}

.sidebar-menu__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  color: #666;
}
.sidebar-menu__link:hover .sidebar-menu__icon {
  color: #333;
}
.sidebar-menu__link:hover {
  background: #f8f8f8;
  color: #000;
}

.sidebar-menu__link--title {
  font-weight: 600;
  font-size: 16px;
}

.sidebar-menu__toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 100%;
  min-height: 50px;
  background: none;
  border: none;
  border-left: 1px solid #f0f0f0;
  cursor: pointer;
  color: #666;
  transition: background 0.2s, color 0.2s;
}
.sidebar-menu__toggle:hover {
  background: #f0f0f0;
  color: #333;
}

.sidebar-menu__back {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 15px 20px;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  color: #666;
  transition: color 0.2s;
}
.sidebar-menu__back:hover { color: #333; }
</style>

<script>
(function() {
  const trigger = document.querySelector('[data-sidebar-menu-open]');
  const sidebar = document.querySelector('[data-sidebar-menu]');
  const overlay = document.querySelector('[data-sidebar-menu-overlay]');
  const closeBtn = document.querySelector('[data-sidebar-menu-close]');
  
  if (!trigger || !sidebar) return;

  function openMenu() {
    sidebar.classList.add('is-active');
    overlay.classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    sidebar.classList.remove('is-active');
    overlay.classList.remove('is-active');
    document.body.style.overflow = '';
    // Reset submenus
    document.querySelectorAll('.sidebar-menu__list.is-active').forEach(el => {
      el.classList.remove('is-active');
    });
  }

  trigger.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);

  // Toggle submenus
  document.querySelectorAll('[data-menu-toggle]').forEach(btn => {
    btn.addEventListener('click', function() {
      const item = this.closest('.sidebar-menu__item');
      const submenu = item.querySelector('.sidebar-menu__list');
      if (submenu) {
        submenu.classList.add('is-active');
      }
    });
  });

  // Back buttons
  document.querySelectorAll('[data-menu-back]').forEach(btn => {
    btn.addEventListener('click', function() {
      const submenu = this.closest('.sidebar-menu__list');
      if (submenu) {
        submenu.classList.remove('is-active');
      }
    });
  });

  // Close on escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && sidebar.classList.contains('is-active')) {
      closeMenu();
    }
  });
})();
</script>

{%- endif -%}
