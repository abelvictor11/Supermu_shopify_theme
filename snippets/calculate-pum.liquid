{%- comment -%}
Calcula el PUM (Precio por Unidad de Medida) considerando descuentos activos.
Params:
  - product: required - El producto
  - mode: 'html' (default) renderiza el HTML completo, 'price_only' solo retorna el precio a usar
Usage:
  {% render 'calculate-pum', product: product %}
{%- endcomment -%}

{%- assign _product = product -%}
{%- assign _mode = mode | default: 'html' -%}

{%- if _product -%}
  {%- comment -%} 1. Detectar descuentos activos {%- endcomment -%}
  {%- capture _gp -%}{% render 'discount-label', product: _product, mode: 'percent' %}{%- endcapture -%}
  {%- capture _rp -%}{% render 'daily-discount-label', product: _product, mode: 'percent' %}{%- endcapture -%}
  {%- assign _gp_raw = _gp | strip | remove: '%' -%}
  {%- assign _rp_raw = _rp | strip | remove: '%' -%}
  {%- assign gp = _gp_raw | plus: 0 -%}
  {%- assign rp = _rp_raw | plus: 0 -%}
  
  {%- comment -%} Limpiar valores si contienen comentarios {%- endcomment -%}
  {%- if gp == 0 and _gp_raw contains '#}' -%}
    {%- assign gp = _gp_raw | split: '#}' | last | strip | plus: 0 -%}
  {%- endif -%}
  {%- if rp == 0 and _rp_raw contains '#}' -%}
    {%- assign rp = _rp_raw | split: '#}' | last | strip | plus: 0 -%}
  {%- endif -%}

  {%- comment -%} 2. Determinar el porcentaje de descuento ganador {%- endcomment -%}
  {%- assign _discount_percent = 0 -%}
  {%- if rp > gp and rp > 0 -%}
    {%- assign _discount_percent = rp -%}
  {%- elsif gp > rp and gp > 0 -%}
    {%- assign _discount_percent = gp -%}
  {%- elsif rp == gp and rp > 0 -%}
    {%- assign _discount_percent = rp -%}
  {%- endif -%}

  {%- comment -%} 3. Calcular el precio a usar (original o con descuento) {%- endcomment -%}
  {%- assign _original_price = _product.price -%}
  {%- assign _final_price = _original_price -%}
  
  {%- if _discount_percent > 0 -%}
    {%- assign _discount_amount = _original_price | times: _discount_percent | divided_by: 100.0 -%}
    {%- assign _final_price = _original_price | minus: _discount_amount -%}
  {%- endif -%}

  {%- comment -%} 4. Obtener factor y unidad de medida {%- endcomment -%}
  {%- assign factor_text = _product.metafields.custom.factor_unidad_de_medida.value | default: "1,0" -%}
  {%- assign factor = factor_text | replace: ",", "." | plus: 0 -%}
  {%- assign unidad_medida = _product.metafields.custom.unidad_de_medida_pum -%}

  {%- comment -%} 5. Convertir precio a decimal y calcular PUM {%- endcomment -%}
  {%- assign precio_decimal = _final_price | divided_by: 100.0 -%}
  {%- assign pum = precio_decimal | divided_by: factor | round: 2 -%}

  {%- comment -%} 6. Formatear PUM a 2 decimales {%- endcomment -%}
  {%- assign pum_parts = pum | split: "." -%}
  {%- if pum_parts.size == 1 -%}
    {%- assign pum_formatted = pum | append: ".00" -%}
  {%- else -%}
    {%- assign decimal_digits = pum_parts[1] | size -%}
    {%- if decimal_digits == 1 -%}
      {%- assign pum_formatted = pum | append: "0" -%}
    {%- else -%}
      {%- assign pum_formatted = pum -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} 7. Renderizar según el modo {%- endcomment -%}
  {%- if _mode == 'price_only' -%}
    {{- _final_price -}}
  {%- elsif _mode == 'pum_only' -%}
    {{- pum_formatted -}}
  {%- else -%}
    <div class="custom-pum m-0 mb-10">
