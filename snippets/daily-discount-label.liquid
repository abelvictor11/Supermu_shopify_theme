{%- comment -%}
Daily discount label (red) based on product tags and current weekday.
Params:
  - product: required
Behavior:
  - Uses weekday-specific mapping to tag→percent.
  - Shows first matching tag's discount.
{%- endcomment -%}
{%- assign _product = product -%}
{%- assign _mode = mode | default: 'html' -%}
{%- if _product -%}
  {%- assign _weekday = 'now' | date: '%w' -%} {# 0=Sunday,1=Monday,...6=Saturday #}
  {%- case _weekday -%}
    {%- when '1' -%}
      {%- assign _day_translation = 'LUNES' -%}
      {%- assign _discount_rules = 'MASCOTAS:20' -%}
    {%- when '2' -%}
      {%- assign _day_translation = 'MARTES' -%}
      {%- assign _discount_rules = 'CARNES,CARNE,CERDO:10|POLLO:20' -%}
    {%- when '3' -%}
      {%- assign _day_translation = 'MIÉRCOLES' -%}
      {%- assign _discount_rules = 'FRUVER:25' -%}
    {%- when '4' -%}
      {%- assign _day_translation = 'JUEVES' -%}
      {%- assign _discount_rules = 'PESCADO,MARISCOS,PESCADOS Y MARISCOS,CARNES BLANCAS PESCADO:20' -%}
    {%- when '5' -%}
      {%- assign _day_translation = 'VIERNES' -%}
      {%- assign _discount_rules = 'CARNES,CARNE,CERDO:10|FRUVER:25' -%}
    {%- when '6' -%}
      {%- assign _day_translation = 'SÁBADO' -%}
      {%- assign _discount_rules = 'VINO,VINOS:30' -%}
    {%- else -%}
      {%- assign _discount_rules = '' -%}
  {%- endcase -%}

  {%- if _discount_rules != '' -%}
    {%- comment -%} Ensure we have tags even in collection cards {%- endcomment -%}
    {%- assign _tags = _product.tags -%}
    {%- if _tags == blank or _tags.size == 0 -%}
      {%- if _product.handle != blank -%}
        {%- assign _p2 = all_products[_product.handle] -%}
        {%- if _p2 != blank and _p2.tags != blank -%}
          {%- assign _tags = _p2.tags -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign _product_tags_joined_up = _tags | join: '||||' | upcase -%}
    {%- comment -%} Build a broader haystack: tags + title + type + vendor {%- endcomment -%}
    {%- assign _title_up = _product.title | upcase -%}
    {%- assign _type_up = _product.type | upcase -%}
    {%- assign _vendor_up = _product.vendor | upcase -%}
    {%- assign _haystack_up = _product_tags_joined_up | append: '||||' | append: _title_up | append: '||||' | append: _type_up | append: '||||' | append: _vendor_up -%}
    {%- assign _groups = _discount_rules | split: '|' -%}
    {%- assign _applied = false -%}
    {%- assign _debug_matched = '' -%}
    {%- assign _debug_percent = 0 -%}
    {%- for _group in _groups -%}
      {%- assign _parts = _group | split: ':' -%}
      {%- assign _rule_tags = _parts[0] | split: ',' -%}
      {%- assign _percent = _parts[1] | default: 0 | times: 1 -%}
      {%- for _tag in _rule_tags -%}
        {%- assign _t = _tag | strip | upcase -%}
        {%- if _haystack_up contains _t and _percent > 0 -%}
          {%- assign _debug_matched = _t -%}
          {%- assign _debug_percent = _percent -%}
          {%- if _mode == 'percent' -%}
            {{- _percent -}}
          {%- else -%}
            {%- assign _original = _product.price -%}
            {%- assign _disc = _original | times: _percent | divided_by: 100.0 -%}
            {%- assign _final = _original | minus: _disc | money -%}
            <div class="daily-discount-tag" style="border-left:3px solid #FF0000;padding:10px;margin:10px 0;border-radius:0 5px 5px 0;background:#FFF9F9;">
              <div style="display:flex;align-items:center;gap:8px;">
                <span style="text-decoration:line-through;color:#666;">{{ _original | money }}</span>
                <span style="font-weight:bold;color:#FF0000;">{{ _final }}</span>
              </div>
              <div style="background:#FF0000;color:#fff;display:inline-block;padding:2px 8px;border-radius:3px;font-size:12px;margin-top:5px;">
                ¡OFERTA {{ _t }} -{{ _percent }}% ({{ _day_translation }})
              </div>
            </div>
          {%- endif -%}
          {%- assign _applied = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if _applied -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if _mode != 'percent' and request.design_mode -%}
    <div style="font-size:11px;color:#777;margin-top:6px;">
      (daily debug) WD={{ _weekday }} rules='{{ _discount_rules }}' matched='{{ _debug_matched }}' rp={{ _debug_percent }} tags=[{% for t in _product.tags %}<code>{{ t }}</code>{% unless forloop.last %}, {% endunless %}{% endfor %}]
    </div>
  {%- endif -%}
{%- endif -%}
