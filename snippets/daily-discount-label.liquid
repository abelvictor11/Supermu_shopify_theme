{%- comment -%}
Daily discount label (red) based on product tags and current weekday.
Params:
  - product: required
  - mode: 'html' (default) or 'percent' to output only the percent number for detection
Behavior:
  - Uses weekday-specific mapping to tag→percent.
  - Shows first matching tag's discount.
  - Can be globally disabled via settings.daily_discounts_enabled
  - In html mode: always outputs a .js-ddc span with data-weekday/tags/price so
    correctDailyDiscounts() in custom.js can fix stale Shopify CDN cache on page load.
{%- endcomment -%}
{%- assign _product = product -%}
{%- assign _mode = mode | default: 'html' -%}
{%- assign _enabled = false -%}
{%- if settings.daily_discounts_enabled == true -%}
  {%- assign _enabled = true -%}
{%- endif -%}
{%- if _product and _enabled -%}
  {%- assign _weekday = 'now' | date: '%w' -%}
  {%- comment -%} 0=Sunday,1=Monday,...6=Saturday {%- endcomment -%}
  {%- case _weekday -%}
    {%- when '1' -%}
      {%- assign _discount_rules = 'MASCOTAS:20' -%}
    {%- when '2' -%}
      {%- assign _discount_rules = 'CARNES,CARNE,CERDO:10|POLLO:20' -%}
    {%- when '3' -%}
      {%- assign _discount_rules = 'FRUVER:25' -%}
    {%- when '4' -%}
      {%- assign _discount_rules = 'PESCADO,MARISCOS,PESCADOS Y MARISCOS,CARNES BLANCAS PESCADO:20' -%}
    {%- when '5' -%}
      {%- assign _discount_rules = 'CARNES,CARNE,CERDO:10|FRUVER:25' -%}
    {%- when '6' -%}
      {%- assign _discount_rules = 'VINO,VINOS:30' -%}
    {%- else -%}
      {%- assign _discount_rules = '' -%}
  {%- endcase -%}

  {%- comment -%} Compute discount — separated from output so JS can replicate the logic {%- endcomment -%}
  {%- assign _applied = false -%}
  {%- assign _applied_pct = 0 -%}
  {%- assign _applied_original = 0 -%}
  {%- assign _applied_final = 0 -%}
  {%- if _discount_rules != '' -%}
    {%- assign _tags_src = _product.tags -%}
    {%- if _product.handle != blank -%}
      {%- if _tags_src == blank or _tags_src.size == 0 -%}
        {%- assign _p2 = all_products[_product.handle] -%}
        {%- if _p2 and _p2.tags != blank -%}
          {%- assign _tags_src = _p2.tags -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign _product_tags_up = _tags_src | join: '||||' | upcase | split: '||||' -%}
    {%- assign _groups = _discount_rules | split: '|' -%}
    {%- for _group in _groups -%}
      {%- unless _applied -%}
        {%- assign _parts = _group | split: ':' -%}
        {%- assign _rule_tags = _parts[0] | split: ',' -%}
        {%- assign _pct = _parts[1] | default: 0 | times: 1 -%}
        {%- for _tag in _rule_tags -%}
          {%- assign _t = _tag | strip | upcase -%}
          {%- if _product_tags_up contains _t and _pct > 0 -%}
            {%- assign _applied = true -%}
            {%- assign _applied_pct = _pct -%}
            {%- assign _applied_original = _product.price -%}
            {%- assign _applied_disc = _applied_original | times: _pct | divided_by: 100.0 -%}
            {%- assign _applied_final = _applied_original | minus: _applied_disc -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}

  {%- comment -%} Output {%- endcomment -%}
  {%- if _mode == 'percent' -%}
    {%- if _applied -%}{{ _applied_pct }}{%- else -%}0{%- endif -%}
  {%- else -%}
    {%- assign _ptags_up = _product.tags | join: '|||' | upcase -%}
    <span class="js-ddc" data-weekday="{{ _weekday }}" data-tags="{{ _ptags_up }}" data-price="{{ _product.price }}" style="display:contents;">
      {%- if _applied -%}
        <div class="daily-discount-tag compact-discount-label">
          <span class="discount-percent-label">Ahora -{{ _applied_pct }}%</span>
          <span class="discount-price-original">{{ _applied_original | money }}</span>
          <span class="discount-price-final">{{ _applied_final | money }}</span>
        </div>
      {%- endif -%}
    </span>
    {%- if request.design_mode -%}
      <div style="font-size:11px;color:#777;margin-top:6px;">
        (daily debug) day='{{ _weekday }}' rules='{{ _discount_rules }}' pct={{ _applied_pct }} tags=[{% for t in _product.tags %}<code>{{ t }}</code>{% unless forloop.last %}, {% endunless %}{% endfor %}]
      </div>
    {%- endif -%}
  {%- endif -%}
{%- else -%}
  {%- if _mode == 'percent' -%}0{%- endif -%}
{%- endif -%}
