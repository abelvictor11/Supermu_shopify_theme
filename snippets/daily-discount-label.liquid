{%- comment -%}
Daily discount label (red) based on product tags and current weekday.
Params:
  - product: required
  - mode: 'html' (default) or 'percent' to output only the percent number for detection
Behavior:
  - Uses weekday-specific mapping to tag→percent.
  - Shows first matching tag's discount.
  - Can be globally disabled via settings.daily_discounts_enabled
{%- endcomment -%}
{%- assign _product = product -%}
{%- assign _mode = mode | default: 'html' -%}
{%- assign _enabled = settings.daily_discounts_enabled | default: true -%}
{%- if _product and _enabled -%}
  {%- assign _weekday = 'now' | date: '%w' -%} 
  {%- comment -%} 0=Sunday,1=Monday,...6=Saturday {%- endcomment -%}
  {%- case _weekday -%}
    {%- when '1' -%}
      {%- assign _day_translation = 'LUNES' -%}
      {%- assign _discount_rules = 'MASCOTAS:20' -%}
    {%- when '2' -%}
      {%- assign _day_translation = 'MARTES' -%}
      {%- assign _discount_rules = 'CARNES,CARNE,CERDO:10|POLLO:20' -%}
    {%- when '3' -%}
      {%- assign _day_translation = 'MIÉRCOLES' -%}
      {%- assign _discount_rules = 'FRUVER:25' -%}
    {%- when '4' -%}
      {%- assign _day_translation = 'JUEVES' -%}
      {%- assign _discount_rules = 'PESCADO,MARISCOS,PESCADOS Y MARISCOS,CARNES BLANCAS PESCADO:20' -%}
    {%- when '5' -%}
      {%- assign _day_translation = 'VIERNES' -%}
      {%- assign _discount_rules = 'CARNES,CARNE,CERDO:10|FRUVER:25' -%}
    {%- when '6' -%}
      {%- assign _day_translation = 'SÁBADO' -%}
      {%- assign _discount_rules = 'VINO,VINOS:30' -%}
    {%- else -%}
      {%- assign _discount_rules = '' -%}
  {%- endcase -%}

  {%- if _discount_rules != '' -%}
    {%- assign _tags_src = _product.tags -%}
    {%- if _product.handle != blank -%}
      {%- if _tags_src == blank or _tags_src.size == 0 -%}
        {%- assign _p2 = all_products[_product.handle] -%}
        {%- if _p2 and _p2.tags != blank -%}
          {%- assign _tags_src = _p2.tags -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign _product_tags_up = _tags_src | join: '||||' | upcase | split: '||||' -%}
    {%- assign _groups = _discount_rules | split: '|' -%}
    {%- assign _applied = false -%}
    {%- assign _debug_matched = '' -%}
    {%- assign _debug_percent = 0 -%}
    {%- for _group in _groups -%}
      {%- assign _parts = _group | split: ':' -%}
      {%- assign _rule_tags = _parts[0] | split: ',' -%}
      {%- assign _percent = _parts[1] | default: 0 | times: 1 -%}
      {%- for _tag in _rule_tags -%}
        {%- assign _t = _tag | strip | upcase -%}
        {%- if _product_tags_up contains _t and _percent > 0 -%}
          {%- if _mode == 'percent' -%}
            {{- _percent -}}
          {%- else -%}
            {%- assign _original = _product.price -%}
            {%- assign _disc = _original | times: _percent | divided_by: 100.0 -%}
            {%- assign _final = _original | minus: _disc -%}
            <div class="daily-discount-tag compact-discount-label">
              <span class="discount-percent-label">Ahora -{{ _percent }}%</span>
              <span class="discount-price-original">{{ _original | money }}</span>
              <span class="discount-price-final">{{ _final | money }}</span>
            </div>
          {%- endif -%}
          {%- assign _debug_matched = _t -%}
          {%- assign _debug_percent = _percent -%}
          {%- assign _applied = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if _applied -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if _mode != 'percent' and request.design_mode -%}
    <div style="font-size:11px;color:#777;margin-top:6px;">
      (daily debug) day='{{ _current_day }}' rules='{{ _discount_rules }}' matched='{{ _debug_matched }}' rp={{ _debug_percent }} tags=[{% for t in _product.tags %}<code>{{ t }}</code>{% unless forloop.last %}, {% endunless %}{% endfor %}]
    </div>
  {%- endif -%}
{%- else -%}
  {%- comment -%}Daily discounts disabled: return 0 in percent mode{%- endcomment -%}
  {%- if _mode == 'percent' -%}0{%- endif -%}
{%- endif -%}

