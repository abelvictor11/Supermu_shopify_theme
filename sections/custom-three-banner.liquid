<section class="custom-three-banner" id="three-banner-{{ section.id }}">
   <div class="three-banner-grid">
      {%- assign banner_index = 0 -%}
      {%- for block in section.blocks -%}
      {% case block.type %}
      {%- when 'banner_one' -%}
      <a href="{{ block.settings.link | default: '#' }}" class="banner-item banner-small" data-banner-index="{{ banner_index }}"
         style="background: {{ block.settings.bg_color }}; background-image: url('{{ block.settings.image | image_url: width: 800 }}');">
         <div class="grid-content">
           <p>{{ block.settings.subtitle }}</p>
            <h2>{{ block.settings.title }}</h2>
            {%- if block.settings.cta_text != blank -%}
              <div class="cta-button">
                {{ block.settings.cta_text }}
              </div>
            {%- endif -%}
         </div>
      </a>
      {%- assign banner_index = banner_index | plus: 1 -%}

      {%- when 'banner_two' -%}
      <a href="{{ block.settings.link | default: '#' }}" class="banner-item banner-small" data-banner-index="{{ banner_index }}"
         style="background: {{ block.settings.bg_color }}; background-image: url('{{ block.settings.image | image_url: width: 800 }}');">
         <div class="grid-content">
           <p>{{ block.settings.subtitle }}</p>
            <h2>{{ block.settings.title }}</h2>
            {%- if block.settings.cta_text != blank -%}
              <div class="cta-button">
                {{ block.settings.cta_text }}
              </div>
            {%- endif -%}
         </div>
      </a>
      {%- assign banner_index = banner_index | plus: 1 -%}

      {%- when 'banner_three' -%}
      <a href="{{ block.settings.link | default: '#' }}" class="banner-item banner-medium" data-banner-index="{{ banner_index }}"
         style="background: {{ block.settings.bg_color }}; background-image: url('{{ block.settings.image | image_url: width: 1200 }}');">
         <div class="grid-content">
           <p>{{ block.settings.subtitle }}</p>
            <h2>{{ block.settings.title }}</h2>
            {%- if block.settings.cta_text != blank -%}
              <div class="cta-button">
                {{ block.settings.cta_text }}
              </div>
            {%- endif -%}
         </div>
      </a>
      {%- assign banner_index = banner_index | plus: 1 -%}
      {%- endcase -%}
      {%- endfor -%}
   </div>
   <div class="three-banner-dots d-lg-none">
      {%- for block in section.blocks -%}
        <span class="three-banner-dot{% if forloop.first %} active{% endif %}" data-dot-index="{{ forloop.index0 }}"></span>
      {%- endfor -%}
   </div>
</section>

{% schema %}
{
  "name": "Three Banners 33-33-33",
  "settings": [],
  "blocks": [
    {
      "type": "banner_one",
      "name": "Banner 1 (33%)",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen de Fondo" },
        { "type": "color", "id": "bg_color", "label": "Color de Fondo", "default": "#f5f5f5" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo" },
        { "type": "text", "id": "cta_text", "label": "Texto del Botón", "default": "Ver más" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    },
    {
      "type": "banner_two",
      "name": "Banner 2 (33%)",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen de Fondo" },
        { "type": "color", "id": "bg_color", "label": "Color de Fondo", "default": "#f5f5f5" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo" },
        { "type": "text", "id": "cta_text", "label": "Texto del Botón", "default": "Ver más" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    },
    {
      "type": "banner_three",
      "name": "Banner 3 (33%)",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen de Fondo" },
        { "type": "color", "id": "bg_color", "label": "Color de Fondo", "default": "#f5f5f5" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo" },
        { "type": "text", "id": "cta_text", "label": "Texto del Botón CTA", "default": "Ver más" },
        { "type": "url", "id": "link", "label": "Enlace del CTA" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three Banners 33-33-33",
      "category": "Custom",
      "blocks": [
        { "type": "banner_one" },
        { "type": "banner_two" },
        { "type": "banner_three" }
      ]
    }
  ]
}
{% endschema %}

<style>
.custom-three-banner {
  padding: 15px;
  max-width: 1770px;
  margin: 0 auto;
}

.three-banner-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  align-items: stretch;
}

.banner-item {
  position: relative;
  width: 100%;
  padding-top: 58%;
  background-size: cover !important;
  background-position: center;
  border-radius: 10px;
  overflow: hidden;
  background-repeat: no-repeat !important;
  display: block;
  text-decoration: none;
  color: inherit;
}

.banner-item .grid-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 20px;
  border-radius: 10px;
}

.cta-button {
  margin-top: 10px;
  padding: 10px 20px;
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  text-align: center;
  border-radius: 5px;
  text-decoration: none;
}

/* Dot indicators - hidden on desktop via d-lg-none */
.three-banner-dots {
  display: none;
}

/* Mobile carousel */
@media (max-width: 1024px) {
  .three-banner-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: pan-x;
    cursor: grab;
  }

  .three-banner-grid:active {
    cursor: grabbing;
  }

  .three-banner-grid::-webkit-scrollbar {
    display: none;
  }

  .three-banner-grid .banner-item {
    flex: 0 0 100%;
    min-width: 100%;
    scroll-snap-align: start;
    border-radius: 10px;
    padding-top: 65%;
    -webkit-user-drag: none;
    user-select: none;
    background-color: #fff;
    background-size: contain !important;
  }

  .three-banner-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 12px 0 4px;
  }

  .three-banner-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ccc;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .three-banner-dot.active {
    background: #333;
    transform: scale(1.3);
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var section = document.getElementById('three-banner-{{ section.id }}');
  if (!section) return;

  var grid = section.querySelector('.three-banner-grid');
  var dots = section.querySelectorAll('.three-banner-dot');
  if (!grid || dots.length === 0) return;

  var scrollTimeout;
  grid.addEventListener('scroll', function() {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(function() {
      var scrollLeft = grid.scrollLeft;
      var itemWidth = grid.offsetWidth;
      var activeIndex = Math.round(scrollLeft / itemWidth);

      dots.forEach(function(dot, i) {
        dot.classList.toggle('active', i === activeIndex);
      });
    }, 50);
  });

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var index = parseInt(this.getAttribute('data-dot-index'));
      grid.scrollTo({
        left: index * grid.offsetWidth,
        behavior: 'smooth'
      });
    });
  });
});
</script>