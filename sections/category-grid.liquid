        {
          "type": "url",
          "id": "category_url",
          "label": "URL Personalizada"
        },
        {
          "type": "collection",
          "id": "category_collection",
          "label": "Colección"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid/Carousel",
