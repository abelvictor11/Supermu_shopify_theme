{% comment %}
  Category Grid Section
  This section displays a grid of categories on desktop (5x2) and a carousel on mobile (2 items visible)
{% endcomment %}

<section class="category-grid-section" data-section-id="{{ section.id }}">
  <div class="category-grid-container">
    <!-- Skeleton loader -->
    <div class="category-skeleton" id="skeleton-{{ section.id }}">
      {% for i in (1..10) %}
        <div class="skeleton-category-item">
          <div class="skeleton-category-image skeleton-loader"></div>
          <div class="skeleton-category-name skeleton-loader"></div>
        </div>
      {% endfor %}
    </div>
    
    <div class="category-grid desktop-grid">
      {% for block in section.blocks limit: 10 %}
        <div class="category-item">
          <a href="{% if block.settings.category_url != blank %}{{ block.settings.category_url }}{% else %}{{ block.settings.category_collection.url }}{% endif %}" class="category-link">
            <div class="category-image">
              <img 
                src="{{ block.settings.category_image | img_url: '300x300', crop: 'center' }}" 
                alt="{{ block.settings.category_name }}" 
                class="circular-image"
                onload="this.closest('.category-item').classList.add('loaded'); document.getElementById('skeleton-{{ section.id }}').style.display = 'none';"
              >
            </div>
            <p class="category-name">{{ block.settings.category_name }}</p>
          </a>
        </div>
      {% endfor %}
    </div>

    <div class="category-grid mobile-carousel swiper" id="category-swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {% for block in section.blocks limit: 10 %}
          <div class="swiper-slide category-item">
            <a href="{% if block.settings.category_url != blank %}{{ block.settings.category_url }}{% else %}{{ block.settings.category_collection.url }}{% endif %}" class="category-link">
              <div class="category-image">
                <img 
                  src="{{ block.settings.category_image | img_url: '300x300', crop: 'center' }}" 
                  alt="{{ block.settings.category_name }}" 
                  class="circular-image"
                  onload="this.closest('.category-item').classList.add('loaded'); document.getElementById('skeleton-{{ section.id }}').style.display = 'none';"
                >
              </div>
              <p class="category-name">{{ block.settings.category_name }}</p>
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-button-next" id="category-swiper-next-{{ section.id }}"></div>
      <div class="swiper-button-prev" id="category-swiper-prev-{{ section.id }}"></div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (window.innerWidth < 768) {
    const categorySwiper = new Swiper('#category-swiper-{{ section.id }}', {
      slidesPerView: 2,
      spaceBetween: 20,
      preloadImages: false,
      lazy: false,
      watchSlidesProgress: true,
      watchSlidesVisibility: true,
      navigation: {
        nextEl: '#category-swiper-next-{{ section.id }}',
        prevEl: '#category-swiper-prev-{{ section.id }}'
      },
      on: {
        init: function() {
          // Ocultar skeleton después de inicializar
          setTimeout(() => {
            const skeleton = document.getElementById('skeleton-{{ section.id }}');
            if (skeleton) {
              skeleton.style.display = 'none';
            }
          }, 100);
        }
      }
    });
  } else {
    // En desktop, ocultar skeleton cuando carguen las imágenes
    setTimeout(() => {
      const skeleton = document.getElementById('skeleton-{{ section.id }}');
      if (skeleton) {
        skeleton.style.display = 'none';
      }
    }, 100);
  }
});
</script>

