<style>
.category-grid-section {
  position: relative;
  text-align: center;
  padding: 15px;
   max-width: 1320px;
 /* max-width: 1770px; */
  margin: 0 auto;
}

/* Desktop Grid Styles */
@media screen and (min-width: 768px) {
  .mobile-carousel {
    display: none;
  }
  
  .desktop-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 20px;
    padding: 20px;
  }
}

/* Mobile Carousel Styles */
@media screen and (max-width: 767px) {
  .desktop-grid {
    display: none;
  }
  
  .mobile-carousel {
    display: block;
    padding: 20px 40px;
  }
}

/* Skeleton Styles */
.category-skeleton {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 20px;
  padding: 20px;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 2;
  background: #fff;
  transition: opacity 0.3s ease;
}

@media screen and (max-width: 767px) {
  .category-skeleton {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: auto;
  }
}

.skeleton-category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.skeleton-category-image {
  width: 100px;
  height: 100px;
  border-radius: 50%;
}

.skeleton-category-name {
  width: 80px;
  height: 16px;
  border-radius: 4px;
}

@keyframes shimmer {
  0% { background-position: -468px 0 }
  100% { background-position: 468px 0 }
}

.skeleton-loader {
  background: #f0f0f0;
  background-image: linear-gradient(
    to right,
    #f0f0f0 0%,
    #e0e0e0 20%,
    #f0f0f0 40%,
    #f0f0f0 100%
  );
  background-repeat: no-repeat;
  background-size: 800px 104px;
  animation: shimmer 1.5s infinite linear;
}

/* Hide skeleton when content is loaded */
.category-item.loaded + .category-skeleton {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

/* Common Styles */
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  color: inherit;
  transition: transform 0.3s ease;
}

.category-link:hover {
  transform: translateY(-5px);
}

.category-image {
  margin-bottom: 10px;
  border-radius: 10px;
  overflow: hidden;
}

.category-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.category-name {
  margin: 0;
  font-size: 14px;
  font-weight: 500;
  display: none;
}

/* Navigation Buttons */
.swiper-button-next,
.swiper-button-prev {
  color: #000;
}

@media screen and (max-width: 767px) {
  .swiper-button-next,
  .swiper-button-prev {
    transform: scale(0.7);
  }
}
</style>
