{%- style -%}
  .wt-cards {
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px;
    background: {{ section.settings.bg_color | default: '#1a0a0a' }};
  }
  .wt-cards__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
    padding: 0 20px;
  }
  .wt-cards__label {
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#c9a96e' }};
    margin-bottom: 12px;
  }
  .wt-cards__heading {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 38px;
    font-weight: 400;
    color: #fff;
    margin: 0 0 12px;
  }
  .wt-cards__intro {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255,255,255,0.6);
  }
  .wt-cards__list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .wt-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    min-height: 480px;
  }
  .wt-card--reverse .wt-card__content { order: -1; }
  .wt-card__photo {
    border-radius: 16px;
    overflow: hidden;
    position: relative;
  }
  .wt-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .wt-card:hover .wt-card__photo img {
    transform: scale(1.03);
  }
  .wt-card__content {
    border-radius: 16px;
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .wt-card__badge {
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin: 0 0 16px;
    font-weight: 600;
  }
  .wt-card__title {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 16px;
  }
  .wt-card__desc {
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
    max-width: 380px;
  }
  .wt-card__icon {
    position: absolute;
    bottom: 24px;
    right: 28px;
    width: 120px;
    height: 120px;
    opacity: 0.85;
  }
  .wt-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .wt-card__cta {
    display: inline-block;
    margin-top: auto;
    padding: 12px 28px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid currentColor;
    border-radius: 4px;
    transition: background 0.3s, color 0.3s;
    width: fit-content;
  }
  .wt-card__cta:hover {
    background: currentColor;
  }
  @media (max-width: 767px) {
    .wt-cards { padding: 40px 0; }
    .wt-cards__heading { font-size: 28px; }
    .wt-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .wt-card__photo {
      height: 280px;
    }
    .wt-card--reverse .wt-card__content { order: 0; }
    .wt-card__content {
      padding: 30px 24px;
      min-height: 360px;
    }
    .wt-card__title { font-size: 28px; }
    .wt-card__icon {
      width: 90px;
      height: 90px;
    }
  }
{%- endstyle -%}

<section class="wt-cards">
  {%- if section.settings.label != blank or section.settings.heading != blank or section.settings.intro != blank -%}
    <div class="wt-cards__header">
      {%- if section.settings.label != blank -%}
        <p class="wt-cards__label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="wt-cards__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="wt-cards__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="wt-cards__list">
    {%- for block in section.blocks -%}
      {%- assign card_bg = block.settings.card_bg_color | default: '#4a0e1e' -%}
      {%- assign text_color = block.settings.text_color | default: '#ffffff' -%}
      {%- assign title_color = block.settings.title_color | default: '#e8522a' -%}
      <div class="wt-card{% if block.settings.image_position == 'left' %} wt-card--reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="wt-card__photo">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 767px) 100vw, 50vw' }}
          {%- else -%}
            <div style="width:100%;height:100%;background:#333"></div>
          {%- endif -%}
        </div>
        <div class="wt-card__content" style="background:{{ card_bg }};color:{{ text_color }}">
          {%- if block.settings.badge != blank -%}
            <p class="wt-card__badge" style="color:{{ text_color }}">{{ block.settings.badge }}</p>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="wt-card__title" style="color:{{ title_color }}">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="wt-card__desc" style="color:{{ text_color }};opacity:0.85">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.cta_text != blank -%}
            <a href="{{ block.settings.cta_url }}" class="wt-card__cta" style="color:{{ title_color }};border-color:{{ title_color }}">{{ block.settings.cta_text }}</a>
          {%- endif -%}
          {%- if block.settings.icon_image != blank -%}
            <div class="wt-card__icon">
              {{ block.settings.icon_image | image_url: width: 240 | image_tag: loading: 'lazy' }}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Wine Landing - Tipos",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta superior",
      "default": "Nuestra Seleccion"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Tipos de Vino"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Texto introductorio"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo seccion",
      "default": "#1a0a0a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento",
      "default": "#c9a96e"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "wine_type",
      "name": "Tipo de vino",
      "settings": [
        {
          "type": "header",
          "content": "Imagen"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto de la columna"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Posicion de la imagen",
          "options": [
            { "value": "right", "label": "Derecha (contenido izq)" },
            { "value": "left", "label": "Izquierda (contenido der)" }
          ],
          "default": "right"
        },
        {
          "type": "header",
          "content": "Contenido"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "TINTO"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titulo",
          "default": "Vino Tinto"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripcion"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Texto del boton",
          "default": "VER VINOS TINTO"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "URL del boton"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icono / Ilustracion",
          "info": "Imagen decorativa en la esquina inferior derecha"
        },
        {
          "type": "header",
          "content": "Colores"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Color de fondo de la card",
          "default": "#4a0e1e"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Color del texto",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Color del titulo y boton",
          "default": "#e8522a"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wine Landing - Tipos",
      "blocks": [
        {
          "type": "wine_type",
          "settings": {
            "badge": "TINTO",
            "title": "Vino Tinto",
            "description": "Elaborado a partir de uvas tintas con maceracion del jugo junto con los hollejos. Rico en taninos, con cuerpo y complejidad.",
            "cta_text": "VER VINOS TINTO",
            "image_position": "left",
            "card_bg_color": "#4a0e1e",
            "text_color": "#ffffff",
            "title_color": "#e8522a"
          }
        },
        {
          "type": "wine_type",
          "settings": {
            "badge": "BLANCO",
            "title": "Vino Blanco",
            "description": "Producido sin contacto con la piel de la uva. Color amarillo palido a dorado, perfil fresco, ligero y acido. Se consume frio.",
            "cta_text": "VER VINOS BLANCO",
            "image_position": "right",
            "card_bg_color": "#f5d5d5",
            "text_color": "#1a0a0a",
            "title_color": "#e8522a"
          }
        },
        {
          "type": "wine_type",
          "settings": {
            "badge": "ROSADO",
            "title": "Vino Rosado",
            "description": "Uvas tintas con contacto breve con hollejos. Fresco, ligero y afrutado, ideal para consumirse joven. Servir a 8-12 grados.",
            "cta_text": "VER VINOS ROSADO",
            "image_position": "left",
            "card_bg_color": "#d4729a",
            "text_color": "#ffffff",
            "title_color": "#fff0f5"
          }
        },
        {
          "type": "wine_type",
          "settings": {
            "badge": "ESPUMOSO",
            "title": "Champan y Cava",
            "description": "Vinos con gas carbonico de segunda fermentacion. Burbujas finas y sabores complejos para celebrar cada momento.",
            "cta_text": "VER ESPUMOSOS",
            "image_position": "right",
            "card_bg_color": "#2a1810",
            "text_color": "#ffffff",
            "title_color": "#c9a96e"
          }
        }
      ]
    }
  ]
}
{% endschema %}
