{% unless template.name == 'page' and template.suffix == 'advent-calendar' %}
{{ 'advent-calendar.css' | asset_url | stylesheet_tag }}
{% endunless %}
{% if section.settings.show_image or section.settings.show_title or section.settings.show_description %}
<div class="advent{% if section.settings.motion_enabled %} advent--motion{% endif %}" data-advent-style="{{ section.id }}">
  {% render 'advent-section-styles', section: section %}
  <section class="advent__closing{% unless section.settings.show_image %} advent__closing--text-only{% endunless %}{% unless section.settings.show_title or section.settings.show_description %} advent__closing--image-only{% endunless %}" aria-label="Navidad para compartir">
    {% if section.settings.show_image %}
      <div class="advent__closing-image">
        {% if section.settings.closing_image != blank %}
          {{ section.settings.closing_image | image_url: width: 1500 | image_tag: widths: '600, 960, 1500', sizes: '(min-width: 800px) 60vw, 100vw', loading: 'lazy', alt: section.settings.image_alt }}
        {% else %}
          <img src="{{ 'advent-bunuelos.jpg' | asset_url }}" width="1500" height="844" alt="{{ section.settings.image_alt | escape }}" loading="lazy">
        {% endif %}
      </div>
    {% endif %}
    {% if section.settings.show_title or section.settings.show_description %}
      <div class="advent__closing-copy">
        {% if section.settings.show_title and section.settings.closing_heading != blank %}<h2><span class="advent__title-ink">{{ section.settings.closing_heading | escape }}</span></h2>{% endif %}
        {% if section.settings.show_description and section.settings.closing_text != blank %}<p>{{ section.settings.closing_text | escape }}</p>{% endif %}
      </div>
    {% endif %}
  </section>
</div>
{% endif %}
{% schema %}
{
  "name":"Adviento: banner inferior",
  "tag":"section",
  "enabled_on":{"templates":["page"]},
  "settings":[
    {"type":"checkbox","id":"show_image","label":"Mostrar imagen","default":true},
    {"type":"image_picker","id":"closing_image","label":"Imagen","info":"Vacío usa la fotografía de buñuelos incluida."},
    {"type":"text","id":"image_alt","label":"Texto alternativo","default":"Buñuelos navideños para compartir en familia"},
    {"type":"checkbox","id":"show_title","label":"Mostrar título","default":true},
    {"type":"text","id":"closing_heading","label":"Título","default":"La mejor parte es compartir."},
    {"type":"checkbox","id":"show_description","label":"Mostrar descripción","default":true},
    {"type":"textarea","id":"closing_text","label":"Descripción","default":"En la mesa, en familia y en esos pequeños momentos que hacen grande la Navidad."},
    {"type":"header","content":"Colores de esta sección"},
    {"type":"color","id":"background_color","label":"Fondo","default":"#ff0303"},
    {"type":"color","id":"heading_color","label":"Color de títulos","default":"#fff5ef","info":"Sobre el rojo de marca, los títulos claros deben mantenerse grandes."},
    {"type":"color","id":"text_color","label":"Color de descripciones y textos","default":"#19080d","info":"El rojo #ff0303 necesita texto oscuro para que las letras pequeñas sean legibles."},
    {"type":"header","content":"Fuente de los títulos"},
    {"type":"select","id":"heading_font_source","label":"Origen de la fuente","default":"inherit","options":[{"value":"inherit","label":"Diseño actual"},{"value":"shopify","label":"Biblioteca de Shopify"},{"value":"custom","label":"Archivo propio WOFF/WOFF2"}]},
    {"type":"font_picker","id":"heading_font","label":"Fuente de Shopify","default":"assistant_n4","visible_if":"{{ section.settings.heading_font_source == 'shopify' }}"},
    {"type":"url","id":"custom_heading_font_url","label":"URL de la fuente propia","info":"Sube un WOFF2 o WOFF con licencia a Contenido → Archivos y pega su URL HTTPS. Si no carga, se usa una fuente de respaldo.","visible_if":"{{ section.settings.heading_font_source == 'custom' }}"},
    {"type":"select","id":"custom_heading_font_weight","label":"Peso del archivo propio","default":"700","options":[{"value":"400","label":"400"},{"value":"500","label":"500"},{"value":"600","label":"600"},{"value":"700","label":"700"},{"value":"800","label":"800"}],"visible_if":"{{ section.settings.heading_font_source == 'custom' }}"},
    {"type":"header","content":"Interlineado del título"},
    {"type":"checkbox","id":"heading_line_height_enabled","label":"Personalizar interlineado","default":false,"info":"Desactivado conserva el interlineado actual de cada título."},
    {"type":"range","id":"heading_line_height","label":"Interlineado en escritorio","unit":"%","min":80,"max":180,"step":1,"default":110,"info":"110% equivale a line-height 1.10. No cambia el tamaño de letra.","visible_if":"{{ section.settings.heading_line_height_enabled }}"},
    {"type":"range","id":"heading_line_height_mobile","label":"Interlineado en móvil","unit":"%","min":80,"max":180,"step":1,"default":120,"visible_if":"{{ section.settings.heading_line_height_enabled }}"},
    {"type":"header","content":"Degradado del título"},
    {"type":"checkbox","id":"heading_gradient_enabled","label":"Usar degradado en el título","default":false,"info":"Desactivado utiliza los colores sólidos actuales. No afecta descripciones ni botones."},
    {"type":"color_background","id":"heading_gradient","label":"Colores y dirección del degradado","default":"linear-gradient(90deg, #ffffff 0%, #fff0b5 100%)","info":"Elige un degradado y mantén todos sus colores legibles sobre el fondo. Vacío conserva el color sólido.","visible_if":"{{ section.settings.heading_gradient_enabled }}"},
    {"type":"range","id":"heading_leading_offset","label":"Ajuste del interlineado: escritorio","min":-20,"max":20,"step":1,"default":0,"unit":"px","visible_if":"{{ section.settings.heading_line_height_enabled }}","info":"Admite negativos para acercar líneas. La altura final se mantiene positiva."},
    {"type":"range","id":"heading_leading_offset_mobile","label":"Ajuste del interlineado: móvil","min":-20,"max":20,"step":1,"default":0,"unit":"px","visible_if":"{{ section.settings.heading_line_height_enabled }}"},
    {"type":"header","content":"Animaciones"},
    {"type":"checkbox","id":"motion_enabled","label":"Animar al hacer scroll","default":true,"info":"Se desactivan solas si el visitante pidió reducir el movimiento en su dispositivo."}
  ],
  "presets":[{"name":"Adviento: banner inferior"}]
}
{% endschema %}
