{%- if section.blocks.size > 0 -%}
    <div class="custom-banner-carousel-section {% unless section.blocks.size > 0 %}loading{% endunless %}" id="section-{{ section.id }}">
        <div class="row">
            <!-- Carrusel de productos -->
            <div class="col-md-8">
                <div class="carousel-products">
                    <div class="carousel__slider_wrapper position-relative">
                        <div class="carousel__slider js-slider-tracking"
                             data-js-carousel
                             data-autoplay="{{ section.settings.autoplay }}"
                             data-speed="{{ section.settings.speed | times: 1000 }}"
                             data-count="3"
                             data-infinite="{{ section.settings.infinite }}"
                             data-arrows="{{ section.settings.arrows }}"
                             data-bullets="{{ section.settings.bullets }}">
                            
                            <!-- Skeletons para el carrusel (se muestran mientras carga) -->
                            <div class="carousel__slick row skeleton-loading" data-js-carousel-slick data-carousel-items>
                                {%- for i in (1..3) -%}
                                    <div class="carousel__item col-auto">
                                        <div class="product-card-skeleton">
                                            <div class="skeleton-loader skeleton-image"></div>
                                            <div class="skeleton-loader skeleton-text"></div>
                                            <div class="skeleton-loader skeleton-text short"></div>
                                        </div>
                                    </div>
                                {%- endfor -%}
                            </div>
                            
                            <!-- Contenido real del carrusel -->
                            {%- for block in section.blocks limit: 1 -%}
                                {%- assign max_count = 9 -%}
                                {%- assign limit = 3 -%}
                                <div class="carousel__slick row loaded-content" data-js-carousel-slick data-carousel-items data-max-count="{{ max_count }}" data-products-pre-row="3" style="display: none;">
                                    {%- for product in collections[block.settings.collection].products limit: max_count -%}
                                        <div class="carousel__item col-auto">
                                            <div class="product-card">
                                                <div class="product-card__image">
                                                    <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}" loading="lazy">
                                                </div>
                                                <div class="product-card__info">
                                                    <h3 class="product-card__title">{{ product.title }}</h3>
                                                    <p class="product-card__price">{{ product.price | money }}</p>
                                                </div>
                                            </div>
                                        </div>
                                    {%- endfor -%}
                                </div>
                            {%- endfor -%}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Banner lateral -->
            <div class="col-md-4">
                <div class="custom-banner">
                    <!-- Skeleton para el banner -->
                    <div class="skeleton-loader skeleton-banner" {% if section.settings.banner_image != blank %}style="display: none;"{% endif %}></div>
                    
                    <!-- Banner real -->
                    {%- if section.settings.banner_image != blank -%}
                        <img src="{{ section.settings.banner_image | img_url: 'master' }}" 
                             alt="{{ section.settings.banner_image.alt }}" 
                             class="img-fluid {% unless section.settings.banner_image != blank %}d-none{% endunless %}"
                             loading="lazy">
                    {%- endif -%}
                    
                    {%- if section.settings.banner_link != blank -%}
                        <a href="{{ section.settings.banner_link }}" class="custom-banner-link"></a>
                    {%- endif -%}
                </div>
            </div>
        </div>
    </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Banner & Carousel",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Autoplay Speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite Scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Show Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bullets",
      "label": "Show Bullets",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Banner & Carousel",
      "category": "Custom"
    }
  ]
}
{% endschema %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
  // Función para inicializar el carrusel y ocultar skeletons
  function initCarousel() {
    const section = document.querySelector('.custom-banner-carousel-section');
    if (!section) return;
    
    // Mostrar contenido real y ocultar skeletons
    const loadedContent = section.querySelector('.loaded-content');
    if (loadedContent) {
      loadedContent.style.display = '';
      section.classList.add('loaded');
    }
    
    // Inicializar Slick carousel si existe
    const carousel = section.querySelector('[data-js-carousel]');
    if (carousel && typeof $.fn.slick === 'function') {
      $(carousel).slick({
        infinite: carousel.dataset.infinite === 'true',
        arrows: carousel.dataset.arrows === 'true',
        dots: carousel.dataset.bullets === 'true',
        autoplay: carousel.dataset.autoplay === 'true',
        autoplaySpeed: parseInt(carousel.dataset.speed) || 3000,
        slidesToShow: 3,
        slidesToScroll: 1,
        responsive: [
          {
            breakpoint: 1024,
            settings: {
              slidesToShow: 2
            }
          },
          {
            breakpoint: 767,
            settings: {
              slidesToShow: 1,
              arrows: false,
              dots: true
            }
          }
        ]
      });
    }
  }
  
  // Simular carga (en producción, esto se activaría con eventos reales)
  setTimeout(initCarousel, 1500);
  
  // Alternativa: Usar imágenes cargadas como trigger
  const images = document.querySelectorAll('.custom-banner-carousel-section img');
  if (images.length > 0) {
    images.forEach(img => {
      if (img.complete) {
        initCarousel();
      } else {
        img.addEventListener('load', initCarousel);
      }
    });
  }
});
</script>