<style>
.custom-grid-banners {
    padding: 15px;
    max-width: 1770px;
    margin: 0 auto;
}

.grid-container-dual {
    display: grid;
    grid-template-columns: 70% 30%;
    gap: 10px;
    align-items: start;
    min-height: 0;
    min-width: 0;
    margin: 0 auto;
    width: 100%;
}

.grid-item {
    position: relative;
    width: 100%;
}

.swiper-slide {
    position: relative;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.swiper-slide-active,
.swiper-slide-duplicate-active {
    opacity: 1;
}

.swiper-slide .slide-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
}

.grid-item-banner_large {
    aspect-ratio: 2243/801;
}

.grid-item-banner_small {
    aspect-ratio: 961/801;
}

@media screen and (max-width: 768px) {
    .grid-container-dual {
        grid-template-columns: 1fr;
        gap: 15px;
    }
}

.custom-grid-banners .grid-item {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
}

.skeleton-loader {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
    animation: shimmer 1s infinite linear;
    background-image: linear-gradient(
        to right,
        #f0f0f0 0%,
        #e0e0e0 20%,
        #f0f0f0 40%,
        #f0f0f0 100%
    );
    background-repeat: no-repeat;
    background-size: 800px 104px;
    position: absolute;
    top: 0;
    left: 0;
}

@keyframes shimmer {
    0% { background-position: -468px 0 }
    100% { background-position: 468px 0 }
}

.swiper-container {
    width: 100%;
    height: 100%;
}

.slide-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #fff;
    background-size: cover !important;
    background-position: center !important;
    position: relative;
}
/*
.slide-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
}
*/
.grid-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 20px;
}

.grid-content h2 {
    font-size: 24px;
    margin: 0 0 10px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.grid-content p {
    font-size: 16px;
    margin: 0 0 20px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
}

.cta-button {
    display: inline-block;
    padding: 10px 20px;
    background: #fff;
    color: #000;
    border-radius: 5px;
    transition: transform 0.3s ease;
}

.cta-button:hover {
    transform: translateY(-2px);
}

/* Estilos de navegación mejorados */
.swiper-button-next,
.swiper-button-prev {
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transition: all 0.3s ease;
}

.swiper-button-next:after,
.swiper-button-prev:after {
    font-size: 20px;
    font-weight: bold;
}

.swiper-button-next:hover,
.swiper-button-prev:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: scale(1.1);
}

/* Cursor de arrastre */
.swiper-container {
    cursor: grab;
}

.swiper-container:active {
    cursor: grabbing;
}

/* Paginación mejorada */
.swiper-pagination {
    bottom: 15px !important;
}

.swiper-pagination-bullet {
    background: #fff;
    opacity: 0.5;
    width: 10px;
    height: 10px;
    margin: 0 5px !important;
    transition: all 0.3s ease;
}

.swiper-pagination-bullet-active {
    opacity: 1;
    background: #fff;
    transform: scale(1.3);
}

.swiper-pagination-bullet:hover {
    opacity: 0.8;
}

/* Bullets dinámicos */
.swiper-pagination-bullet-active-main {
    background: #fff;
}

.swiper-pagination-bullet-active-prev,
.swiper-pagination-bullet-active-next {
    transform: scale(1.1);
}

@media screen and (max-width: 768px) {
    .grid-item-banner_small {
        aspect-ratio: 1;
    }
    .grid-item-banner_large{
        aspect-ratio: 600 / 220;
    }
    .grid-content h2 {
        font-size: 20px;
    }

    .grid-content p {
        font-size: 14px;
    }

    .cta-button {
        padding: 8px 16px;
        font-size: 14px;
    }

    /* Flechas más grandes y visibles en móvil */
    .swiper-button-next,
    .swiper-button-prev {
        width: 40px;
        height: 40px;
        background: rgba(0, 0, 0, 0.6);
    }

    .swiper-button-next:after,
    .swiper-button-prev:after {
        font-size: 18px;
    }

    /* Ajustar posición de flechas en móvil */
    .swiper-button-next {
        right: 5px;
    }

    .swiper-button-prev {
        left: 5px;
    }

    /* Paginación más visible en móvil */
    .swiper-pagination {
        bottom: 10px !important;
    }

    .swiper-pagination-bullet {
        width: 8px;
        height: 8px;
        margin: 0 4px !important;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
