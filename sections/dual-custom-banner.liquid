{%- comment -%}
  Dual Custom Banner Section
  This section displays two banners side by side with configurable widths (70% and 30%)
{%- endcomment -%}

<section class="custom-grid-banners {% unless section.blocks.size > 0 %}section-loading{% endunless %}" id="section-{{ section.id }}">
   <div class="grid-container grid-container-dual">
      {%- for block in section.blocks -%}
      {% case block.type %}
      {%- when 'banner_large' -%}
      <div class="grid-item grid-item-banner_large">
        <!-- Skeleton para banner grande -->
        <div class="skeleton-loader skeleton-banner-large" {% if block.settings.image_1 != blank %}style="display: none;"{% endif %}></div>
        
        <div class="swiper-container large-banner-swiper loaded-content" style="{% if block.settings.image_1 == blank %}display: none;{% else %}display: block;{% endif %}">
          <div class="swiper-wrapper">
            {%- for i in (1..10) -%}
              {%- assign slide_enabled = 'slide_' | append: i | append: '_enabled' -%}
              {%- assign image_key = 'image_' | append: i -%}
              {%- assign title_key = 'title_' | append: i -%}
              {%- assign subtitle_key = 'subtitle_' | append: i -%}
              {%- assign cta_key = 'cta_text_' | append: i -%}
              {%- assign link_key = 'link_' | append: i -%}
              
              {%- if block.settings[slide_enabled] and block.settings[image_key] != blank -%}
                <div class="swiper-slide">
                  <a href="{{ block.settings[link_key] | default: '#' }}" class="slide-content"
                    style="background: {{ block.settings.bg_color }}; background-image: url('{{ block.settings[image_key] | image_url: width: 1400 }}');">
                    <div class="grid-content">
                      <p>{{ block.settings[subtitle_key] }}</p>
                      <h2>{{ block.settings[title_key] }}</h2>
                      {%- if block.settings[cta_key] != blank -%}
                        <div class="cta-button">
                          {{ block.settings[cta_key] }}
                        </div>
                      {%- endif -%}
                    </div>
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="swiper-pagination"></div>
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      </div>

      {%- when 'banner_small' -%}
      <div class="grid-item grid-item-banner_small">
        <!-- Skeleton para banner pequeño -->
        <div class="skeleton-loader skeleton-banner-small" {% if block.settings.image_1 != blank %}style="display: none;"{% endif %}></div>
        
        <div class="swiper-container small-banner-swiper loaded-content" style="{% if block.settings.image_1 == blank %}display: none;{% else %}display: block;{% endif %}">
          <div class="swiper-wrapper">
            {%- for i in (1..10) -%}
              {%- assign slide_enabled = 'slide_' | append: i | append: '_enabled' -%}
              {%- assign image_key = 'image_' | append: i -%}
              {%- assign title_key = 'title_' | append: i -%}
              {%- assign subtitle_key = 'subtitle_' | append: i -%}
              {%- assign cta_key = 'cta_text_' | append: i -%}
              {%- assign link_key = 'link_' | append: i -%}
              
              {%- if block.settings[slide_enabled] and block.settings[image_key] != blank -%}
                <div class="swiper-slide">
                  <a href="{{ block.settings[link_key] | default: '#' }}" class="slide-content"
                    style="background: {{ block.settings.bg_color }}; background-image: url('{{ block.settings[image_key] | image_url: width: 1400 }}');">
                    <div class="grid-content">
                      <p>{{ block.settings[subtitle_key] }}</p>
                      <h2>{{ block.settings[title_key] }}</h2>
                      {%- if block.settings[cta_key] != blank -%}
                        <div class="cta-button">
                          {{ block.settings[cta_key] }}
                        </div>
                      {%- endif -%}
                    </div>
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="swiper-pagination"></div>
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      </div>
      {%- endcase -%}
      {%- endfor -%}
   </div>
</section>

