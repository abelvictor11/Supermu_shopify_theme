    if (!section) return;

    // Precargar todas las imágenes antes de inicializar
    const preloadImages = () => {
        const slides = section.querySelectorAll('.swiper-slide');
        let loadedCount = 0;
        
        slides.forEach(slide => {
            const bgImage = slide.querySelector('.slide-content');
            if (bgImage) {
                const url = bgImage.style.backgroundImage.replace(/url\(['"](.*?)['"]\)/, '$1');
                const img = new Image();
                img.onload = () => {
                    loadedCount++;
                    if (loadedCount === slides.length) {
                        initSwipers();
                    }
                };
                img.src = url;
            }
        });
    };

    const initSwipers = () => {
        const largeBannerSwiper = new Swiper('.large-banner-swiper', {
            init: false,
            loop: true,
            loopAdditionalSlides: 2,
            preloadImages: false,
            watchSlidesProgress: true,
            watchSlidesVisibility: true,
            speed: 800,
            effect: 'fade',
            fadeEffect: {
                crossFade: true
            },
            // Configuración táctil mejorada
            touchRatio: 1,
            touchAngle: 45,
            grabCursor: true,
            simulateTouch: true,
            allowTouchMove: true,
            touchStartPreventDefault: false,
            touchMoveStopPropagation: false,
            // Resistencia al deslizar en los bordes
            resistance: true,
            resistanceRatio: 0.85,
            // Umbral de deslizamiento
            threshold: 10,
            // Soporte para gestos
            passiveListeners: true,
            autoplay: {% if section.settings.autoplay %}{
                delay: {{ section.settings.speed | times: 1000 }},
                disableOnInteraction: false,
                pauseOnMouseEnter: true
            }{% else %}false{% endif %},
            pagination: {% if section.settings.bullets %}{
                el: '.large-banner-swiper .swiper-pagination',
                clickable: true,
                dynamicBullets: true,
                dynamicMainBullets: 3
            }{% else %}false{% endif %},
            navigation: {% if section.settings.arrows %}{
                nextEl: '.large-banner-swiper .swiper-button-next',
                prevEl: '.large-banner-swiper .swiper-button-prev'
            }{% else %}false{% endif %},
            on: {
                init: function() {
                    this.update();
                },
                imagesReady: function() {
                    this.update();
                    this.updateSlides();
                }
            }
        });

        const smallBannerSwiper = new Swiper('.small-banner-swiper', {
            init: false,
            loop: true,
            loopAdditionalSlides: 2,
            preloadImages: false,
            watchSlidesProgress: true,
            watchSlidesVisibility: true,
            speed: 800,
            effect: 'fade',
            fadeEffect: {
                crossFade: true
            },
            // Configuración táctil mejorada
            touchRatio: 1,
            touchAngle: 45,
            grabCursor: true,
            simulateTouch: true,
            allowTouchMove: true,
            touchStartPreventDefault: false,
            touchMoveStopPropagation: false,
            // Resistencia al deslizar en los bordes
            resistance: true,
            resistanceRatio: 0.85,
            // Umbral de deslizamiento
            threshold: 10,
            // Soporte para gestos
            passiveListeners: true,
            autoplay: {% if section.settings.autoplay %}{
                delay: {{ section.settings.speed | times: 1000 }},
                disableOnInteraction: false,
                pauseOnMouseEnter: true
            }{% else %}false{% endif %},
            pagination: {% if section.settings.bullets %}{
                el: '.small-banner-swiper .swiper-pagination',
                clickable: true,
                dynamicBullets: true,
                dynamicMainBullets: 3
            }{% else %}false{% endif %},
            navigation: {% if section.settings.arrows %}{
                nextEl: '.small-banner-swiper .swiper-button-next',
                prevEl: '.small-banner-swiper .swiper-button-prev'
            }{% else %}false{% endif %},
            on: {
                init: function() {
                    this.update();
                },
                imagesReady: function() {
                    this.update();
                    this.updateSlides();
                }
            }
        });

        // Inicializar los swipers
        largeBannerSwiper.init();
        smallBannerSwiper.init();
    };

    // Iniciar la precarga de imágenes
    preloadImages();

    // Ocultar skeleton cuando se carguen las imágenes
    const banners = section.querySelectorAll('.swiper-container');
    banners.forEach(banner => {
        const images = banner.querySelectorAll('img');
        let loadedImages = 0;
        
        images.forEach(img => {
            if (img.complete) {
                loadedImages++;
            } else {
                img.addEventListener('load', () => {
                    loadedImages++;
                    if (loadedImages === images.length) {
                        const skeleton = banner.previousElementSibling;
                        if (skeleton && skeleton.classList.contains('skeleton-loader')) {
                            skeleton.style.display = 'none';
                            banner.style.display = 'block';
                        }
                    }
                });
            }
        });

        if (loadedImages === images.length) {
            const skeleton = banner.previousElementSibling;
            if (skeleton && skeleton.classList.contains('skeleton-loader')) {
                skeleton.style.display = 'none';
                banner.style.display = 'block';
            }
        }
    });
});
</script>