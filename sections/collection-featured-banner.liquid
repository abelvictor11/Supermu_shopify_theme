{%- comment -%}
  Banner Destacado para Colecciones
  - Banner con imagen de fondo
  - Carrusel de productos destacados superpuesto
  - Fila de productos inferior
{%- endcomment -%}

{% include 'global-variables' %}

{%- assign show_section = section.settings.show_section -%}
{%- if show_section == false -%}{%- break -%}{%- endif -%}

{%- assign banner_image = section.settings.banner_image -%}
{%- assign banner_image_mobile = section.settings.banner_image_mobile -%}
{%- assign button_text = section.settings.button_text | default: 'Ver más productos' -%}
{%- assign button_url = section.settings.button_url -%}
{%- assign featured_count = section.settings.featured_products_count | default: 4 -%}

<div class="cfb-section" data-section-id="{{ section.id }}">
  
  {%- comment -%} === BANNER === {%- endcomment -%}
  <div class="cfb-banner">
    {%- if banner_image != blank -%}
      <img 
        src="{{ banner_image | image_url: width: 1920 }}"
        alt="{{ section.settings.banner_alt | escape }}"
        class="cfb-banner__img{% if banner_image_mobile != blank %} d-none d-md-block{% endif %}"
      >
      {%- if banner_image_mobile != blank -%}
        <img 
          src="{{ banner_image_mobile | image_url: width: 768 }}"
          alt="{{ section.settings.banner_alt | escape }}"
          class="cfb-banner__img d-md-none"
        >
      {%- endif -%}
    {%- else -%}
      <div class="cfb-banner__placeholder"></div>
    {%- endif -%}
    
    <div class="cfb-banner__content">
      <div class="container">
        {%- if section.settings.banner_title != blank -%}
          <h2 class="cfb-banner__title">{{ section.settings.banner_title }}</h2>
        {%- endif -%}
        {%- if section.settings.banner_subtitle != blank -%}
          <p class="cfb-banner__subtitle">{{ section.settings.banner_subtitle }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} === PRODUCTOS DESTACADOS (carrusel superpuesto) === {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="cfb-featured">
      <div class="container">
        <div class="cfb-featured__grid">
          {%- for block in section.blocks limit: featured_count -%}
            {%- assign product = all_products[block.settings.product] -%}
            {%- if product != blank -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              {%- assign has_discount = false -%}
              {%- assign discount_pct = 0 -%}
              {%- if variant.compare_at_price > variant.price -%}
                {%- assign has_discount = true -%}
                {%- assign discount_pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
              {%- endif -%}
              
              <div class="cfb-card" {{ block.shopify_attributes }}>
                <a href="{{ product.url }}" class="cfb-card__link">
                  <div class="cfb-card__img-wrap">
                    {%- if product.featured_image != blank -%}
                      <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" class="cfb-card__img">
                    {%- else -%}
                      <div class="cfb-card__no-img">{{ product.title | truncate: 1, '' }}</div>
                    {%- endif -%}
                    
                    {%- if has_discount -%}
                      <span class="cfb-card__badge">-{{ discount_pct }}%</span>
                    {%- endif -%}
                    
                    <div class="cfb-card__price-box">
                      {%- if has_discount -%}
                        <span class="cfb-card__old-price">{{ variant.compare_at_price | money_without_trailing_zeros }}</span>
                      {%- endif -%}
                      <span class="cfb-card__price">{{ variant.price | money_without_trailing_zeros }}</span>
                    </div>
                  </div>
                  <div class="cfb-card__info">
                    <h3 class="cfb-card__title">{{ product.title }}</h3>
                    {%- if product.vendor != blank -%}
                      <p class="cfb-card__vendor">{{ product.vendor }}</p>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} === FILA DE PRODUCTOS INFERIOR === {%- endcomment -%}
  {%- if section.blocks.size > featured_count -%}
    <div class="cfb-products">
      <div class="container">
        <div class="cfb-products__grid">
          {%- for block in section.blocks offset: featured_count -%}
            {%- assign product = all_products[block.settings.product] -%}
            {%- if product != blank -%}
              <div class="cfb-products__item" {{ block.shopify_attributes }}>
                {% include 'product-collection' with product: product, url_without_collection: true %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        
        {%- if button_text != blank -%}
          <div class="cfb-products__btn-wrap">
            <a href="{{ button_url | default: collection.url }}" class="cfb-products__btn">{{ button_text }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

<style>
.cfb-section { margin-bottom: 40px; }

/* Banner */
.cfb-banner { position: relative; min-height: 300px; overflow: hidden; }
@media (min-width: 768px) { .cfb-banner { min-height: 400px; } }

.cfb-banner__img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; }
.cfb-banner__placeholder { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }

.cfb-banner__content { position: relative; z-index: 2; padding: 40px 0 120px; }
@media (min-width: 768px) { .cfb-banner__content { padding: 60px 0 140px; } }

.cfb-banner__title { 
  color: {{ section.settings.text_color | default: '#ffffff' }}; 
  font-size: 28px; font-weight: 700; margin: 0 0 10px; 
  text-shadow: 0 2px 4px rgba(0,0,0,0.3); white-space: pre-line; 
}
@media (min-width: 768px) { .cfb-banner__title { font-size: 42px; } }

.cfb-banner__subtitle { 
  color: {{ section.settings.text_color | default: '#ffffff' }}; 
  font-size: 16px; margin: 0; opacity: 0.9; 
}

/* Productos Destacados */
.cfb-featured { margin-top: -80px; position: relative; z-index: 10; padding-bottom: 20px; }
@media (min-width: 768px) { .cfb-featured { margin-top: -100px; } }

.cfb-featured__grid { 
  display: grid; 
  grid-template-columns: repeat(2, 1fr); 
  gap: 12px; 
}
@media (min-width: 576px) { .cfb-featured__grid { grid-template-columns: repeat(3, 1fr); gap: 15px; } }
@media (min-width: 992px) { .cfb-featured__grid { grid-template-columns: repeat(4, 1fr); gap: 20px; } }

/* Card */
.cfb-card { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
.cfb-card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.15); transform: translateY(-4px); }
.cfb-card__link { display: block; text-decoration: none; transition: transform 0.3s; }

.cfb-card__img-wrap { position: relative; aspect-ratio: 1; background: #f8f8f8; }
.cfb-card__img { width: 100%; height: 100%; object-fit: contain; padding: 10px; }
.cfb-card__no-img { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 48px; color: #ccc; }

.cfb-card__badge { 
  position: absolute; top: 10px; right: 0; 
  background: #e30613; color: #fff; 
  font-size: 12px; font-weight: 700; 
  padding: 4px 10px 4px 12px; 
  clip-path: polygon(10px 0, 100% 0, 100% 100%, 10px 100%, 0 50%); 
}

.cfb-card__price-box { 
  position: absolute; bottom: 10px; right: 10px; 
  background: #c8102e; color: #fff; 
  padding: 8px 12px; border-radius: 4px; 
  text-align: right; line-height: 1.2; 
}
.cfb-card__old-price { display: block; font-size: 11px; text-decoration: line-through; color: #ffeb3b; }
.cfb-card__price { display: block; font-size: 18px; font-weight: 700; }
@media (min-width: 768px) { .cfb-card__price { font-size: 22px; } }

.cfb-card__info { padding: 12px 15px 15px; }
.cfb-card__title { font-size: 14px; font-weight: 600; color: #333; margin: 0 0 4px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cfb-card__vendor { font-size: 12px; color: #666; margin: 0; font-style: italic; }

/* Fila de productos */
.cfb-products { padding: 30px 0 40px; background: #fff; }
.cfb-products__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }
@media (min-width: 576px) { .cfb-products__grid { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
@media (min-width: 992px) { .cfb-products__grid { grid-template-columns: repeat(4, 1fr); gap: 25px; } }

.cfb-products__btn-wrap { text-align: center; margin-top: 30px; }
.cfb-products__btn { 
  display: inline-block; 
  background: {{ section.settings.button_bg_color | default: '#333' }}; 
  color: {{ section.settings.button_text_color | default: '#fff' }}; 
  padding: 12px 30px; border-radius: 4px; 
  font-size: 14px; font-weight: 600; 
  text-decoration: none; text-transform: uppercase; 
  border: 2px solid {{ section.settings.button_bg_color | default: '#333' }}; 
  transition: all 0.3s; 
}
.cfb-products__btn:hover { 
  background: transparent; 
  color: {{ section.settings.button_bg_color | default: '#333' }}; 
}
</style>

{% schema %}
{
  "name": "Banner Destacado",
  "tag": "section",
  "class": "section-cfb",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Mostrar sección",
      "default": true
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Imagen del banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Imagen móvil (opcional)"
    },
    {
      "type": "text",
      "id": "banner_alt",
      "label": "Texto alternativo",
      "default": "Banner promocional"
    },
    {
      "type": "textarea",
      "id": "banner_title",
      "label": "Título",
      "default": "Celebra a lo grande\na precios pequeños"
    },
    {
      "type": "text",
      "id": "banner_subtitle",
      "label": "Subtítulo"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Productos"
    },
    {
      "type": "range",
      "id": "featured_products_count",
      "min": 1,
      "max": 8,
      "step": 1,
      "label": "Productos en carrusel",
      "info": "Los primeros N productos van al carrusel del banner",
      "default": 4
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Ver más productos"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Enlace del botón"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Color del botón",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color texto botón",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "limit": 12,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner Destacado",
      "category": "4) Collections",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ],
  "templates": ["collection"]
}
{% endschema %}
