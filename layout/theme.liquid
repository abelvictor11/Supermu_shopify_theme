   <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> 
   {% endcomment %}

{% comment %}
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Esperar a que el carrito esté cargado (ajustar el selector según tu tema)
  const cartTotalElement = document.querySelector('.cart-total, .subtotal, .cart__subtotal .mb-0'); // Ajusta este selector
  
  if (cartTotalElement) {
    // Extraer el valor numérico del total (eliminar símbolos y separadores)
    const totalText = cartTotalElement.textContent || cartTotalElement.innerText;
    const totalValue = parseFloat(totalText.replace(/[^\d.,]/g, '').replace(',', '.'));
    
    // Verificar si el total es menor a 40,000
    if (totalValue < 40000) {
      // Crear el mensaje de alerta
      const alertMessage = document.createElement('div');
      alertMessage.style.padding = '15px';
      alertMessage.style.margin = '15px 0';
      alertMessage.style.backgroundColor = '#fff3cd';
      alertMessage.style.border = '1px solid #ffeeba';
      alertMessage.style.borderRadius = '4px';
      alertMessage.style.color = '#856404';
      alertMessage.innerHTML = '⚠️ El valor mínimo de compra es de $40,000. Agrega más productos para completar tu pedido.';
      
      // Insertar el mensaje cerca del total (ajustar según tu estructura HTML)
      cartTotalElement.parentNode.insertBefore(alertMessage, cartTotalElement.nextSibling);
      
      // Opcional: también puedes usar un alert() tradicional
      // alert('El valor mínimo de compra es de $40,000');
    }
  }
});
</script> 
{% endcomment %}
{%- if template == 'cart' -%}
<script defer>
document.addEventListener('DOMContentLoaded', function() {
  const MINIMUM_AMOUNT = 40000; // $40.000 COP
  const ALERT_CLASS = 'min-cart-alert';
  const CART_TOTAL_SELECTOR = '.cart__subtotal h3.mb-0';

  // Función mejorada para formato colombiano
  function getCurrentCartTotal() {
    const priceElement = document.querySelector(CART_TOTAL_SELECTOR);
    if (!priceElement) return null;
    
    // Primero intentar leer el atributo data-price-cents (valor original sin conversión)
    const priceCents = priceElement.getAttribute('data-price-cents');
    if (priceCents) {
      // Shopify guarda precios en centavos, dividir por 100 para obtener pesos COP
      // Ejemplo: 2392000 centavos = $23.920 COP
      const numericValue = parseInt(priceCents, 10) / 100;
      console.log('Precio desde data-price-cents:', priceCents, '→', numericValue, 'COP');
      return isNaN(numericValue) ? null : numericValue;
    }
    
    // Fallback: parsear el texto (puede estar afectado por conversión de moneda)
    const priceText = priceElement.textContent.trim();
    // Formato colombiano: $41.512 → 41512
    const numericValue = parseFloat(
      priceText.replace(/[^\d,.]/g, '')
        .replace(/\./g, '') // Elimina puntos de miles
        .replace(',', '.') // Convierte comas decimales
    );
    
    return isNaN(numericValue) ? null : numericValue;
  }

  function showAlert(currentTotal) {
    const missingAmount = MINIMUM_AMOUNT - currentTotal;
    
    const alertHTML = `
      <div class="${ALERT_CLASS}" style="
        padding: 12px 15px;
        margin: 15px 0;
        background: #FFF5F5;
        border-left: 4px solid #FF0000;
        border: 1px solid #ff0000;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
      ">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF0000">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <strong style="color: #FF0000;">¡Faltan $${missingAmount.toLocaleString('es-CO')} COP!</strong>
          <div style="font-size: 0.9em; margin-top: 4px;">
            El mínimo es $${MINIMUM_AMOUNT.toLocaleString('es-CO')} COP • Tu total: $${currentTotal.toLocaleString('es-CO')} COP
          </div>
        </div>
      </div>
    `;
    
    const cartSubtotal = document.querySelector('.cart__subtotal');
    if (cartSubtotal) {
      // Eliminar alerta anterior si existe
      const existingAlert = document.querySelector(`.${ALERT_CLASS}`);
      if (existingAlert) existingAlert.remove();
      
      // Insertar después del subtotal
      cartSubtotal.insertAdjacentHTML('afterend', alertHTML);
    }
  }

  // Función principal de verificación
  function checkCartTotal() {
    const currentTotal = getCurrentCartTotal();
    console.log('Total calculado:', currentTotal);
    
    if (currentTotal !== null && currentTotal < MINIMUM_AMOUNT) {
      console.log('Mostrando alerta...');
      showAlert(currentTotal);
    } else {
      console.log('Ocultando alerta...');
      const existingAlert = document.querySelector(`.${ALERT_CLASS}`);
      if (existingAlert) existingAlert.remove();
    }
  }

  // Observador para cambios dinámicos
  const observer = new MutationObserver(checkCartTotal);
  const priceElement = document.querySelector(CART_TOTAL_SELECTOR);
  
  if (priceElement) {
    observer.observe(priceElement, {
      characterData: true,
      subtree: true,
      childList: true
    });
    
    // Verificación inicial
    checkCartTotal();
  }

  // Eventos para actualizaciones AJAX
  document.addEventListener('ajaxComplete', checkCartTotal);
  document.addEventListener('cart:updated', function() {
    setTimeout(checkCartTotal, 300);
  });

  // Verificación periódica como respaldo
  const checkInterval = setInterval(checkCartTotal, 2000);
});
</script>
{%- endif -%}
</body>
</html>